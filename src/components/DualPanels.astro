---
import Icon from "./icons/Icon.astro";
---

<section id="facets" class="max-w-7xl mx-auto px-4 sm:px-8 py-10 relative z-10">
  <div class="grid lg:grid-cols-2 gap-6 sm:gap-8">
    <!-- Panel 1: Experiencia Profesional Real -->
    <div class="bg-[var(--surface-card)] rounded-xl p-6 sm:p-8 flex flex-col justify-between transition-colors duration-200">
      <div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
          <h2 class="font-display font-bold text-xl sm:text-2xl tracking-tight text-[var(--ink)] flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent)]"></span>
            Experiencia profesional
          </h2>

          <div class="flex items-center gap-2">
            <a
              href="https://github.com/paulollito29-sketch"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-md bg-[var(--surface-lift)] hover:bg-[var(--border-subtle)] text-[var(--ink)] font-medium text-xs tracking-tight transition-colors flex items-center gap-1.5 active:scale-95"
            >
              <Icon name="github" class="w-3.5 h-3.5" /> GitHub
            </a>
            <a
              href="https://www.linkedin.com/in/paulo-espinoza9/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-md bg-[var(--surface-lift)] hover:bg-[var(--border-subtle)] text-[var(--ink)] font-medium text-xs tracking-tight transition-colors flex items-center gap-1.5 active:scale-95"
            >
              <Icon name="linkedin" class="w-3.5 h-3.5 text-[var(--ink-muted)]" /> LinkedIn
            </a>
          </div>
        </div>

        <p class="text-base text-[var(--ink-muted)] leading-relaxed mb-5">
          8 meses de experiencia comprobada en desarrollo Full Stack y optimización SQL en entornos institucionales de alta exigencia.
        </p>

        <!-- Air Force Work Experience Card -->
        <a href="/cv" class="block rounded-xl bg-[var(--surface-lift)] p-5 mb-5 card-hover-lift group">
          <div class="overflow-hidden rounded-lg mb-3.5">
            <img
              src="/assets/rear-of-rack-at-nersc-data-center.webp"
              width="600"
              height="903"
              alt="Persistencia de datos y servidores de producción"
              class="w-full h-40 object-cover rounded-lg group-hover:scale-102 transition-transform duration-300"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xs font-semibold text-[var(--ink)] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
              Servicio de Informática de la Fuerza Aérea
            </span>
            <span class="text-xs text-[var(--ink-muted)] font-medium">Ene – Ago 2026</span>
          </div>

          <h3 class="text-lg font-bold text-[var(--ink)] mb-1.5 group-hover:text-[var(--accent)] transition-colors">
            Programador Full Stack &amp; SQL
          </h3>
          <p class="text-base text-[var(--ink-secondary)] line-clamp-2 mb-3.5 leading-relaxed">
            Diseño y desarrollo de módulos backend escalables con Java y Spring Boot (Spring Data JPA), interfaces web dinámicas en React.js y consultas SQL avanzadas para datos operativos críticos.
          </p>

          <div class="flex flex-wrap gap-1.5">
            {["Java", "Spring Boot", "Spring Data JPA", "React.js", "SQL", "Git"].map((t) => (
              <span class="text-xs px-2.5 py-0.5 rounded-md bg-[var(--bg)] text-[var(--ink-secondary)] font-medium">
                {t}
              </span>
            ))}
          </div>
        </a>
      </div>

      <!-- Bottom Nav Links -->
      <div class="pt-4 flex items-center justify-between text-xs font-medium text-[var(--ink-muted)]">
        <a href="/cv" class="hover:text-[var(--accent)] transition-colors flex items-center gap-1 active:scale-95">
          Ver CV oficial <Icon name="arrow-right" class="w-3 h-3 text-[var(--ink-faint)]" />
        </a>
        <a href="/portfolio" class="hover:text-[var(--accent)] transition-colors flex items-center gap-1 active:scale-95">
          Portafolio <Icon name="arrow-right" class="w-3 h-3 text-[var(--ink-faint)]" />
        </a>
        <a href="/contact" class="hover:text-[var(--accent)] transition-colors flex items-center gap-1 active:scale-95">
          Contacto <Icon name="arrow-right" class="w-3 h-3 text-[var(--ink-faint)]" />
        </a>
      </div>
    </div>

    <!-- Panel 2: Formación Académica UPC & Metodología -->
    <div class="bg-[var(--surface-card)] rounded-xl p-6 sm:p-8 flex flex-col justify-between transition-colors duration-200">
      <div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
          <h2 class="font-display font-bold text-xl sm:text-2xl tracking-tight text-[var(--ink)] flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--ink)]"></span>
            Formación académica
          </h2>

          <div class="flex items-center gap-2">
            <a
              href="/certificates"
              class="px-3 py-1.5 rounded-md bg-[var(--surface-lift)] hover:bg-[var(--border-subtle)] text-[var(--ink)] font-medium text-xs tracking-tight transition-colors flex items-center gap-1.5 active:scale-95"
            >
              <Icon name="award" class="w-3.5 h-3.5 text-[var(--ink-muted)]" /> 10 Certificaciones
            </a>
          </div>
        </div>

        <p class="text-base text-[var(--ink-muted)] leading-relaxed mb-5">
          Estudiante de 7º ciclo de Ingeniería de Sistemas de Información en la UPC, perteneciente al tercio superior académico.
        </p>

        <!-- UPC Academic Profile Card -->
        <a href="/profile" class="block rounded-xl bg-[var(--surface-lift)] p-5 mb-5 card-hover-lift group">
          <div class="overflow-hidden rounded-lg mb-3.5">
            <img
              src="/assets/iglesia-de-santo-domingo-lima-peru-2015.webp"
              width="600"
              height="395"
              alt="Entorno universitario y patrimonio de Lima, Perú"
              class="w-full h-40 object-cover rounded-lg group-hover:scale-102 transition-transform duration-300"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xs font-semibold text-[var(--ink)] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--ink)]"></span>
              Universidad Peruana de Ciencias Aplicadas
            </span>
            <span class="text-xs text-[var(--ink-muted)] font-medium">7º Ciclo · Tercio Superior</span>
          </div>

          <h3 class="text-lg font-bold text-[var(--ink)] mb-1.5 group-hover:text-[var(--accent)] transition-colors">
            Ingeniería de Sistemas de Información
          </h3>
          <p class="text-base text-[var(--ink-secondary)] line-clamp-2 mb-3.5 leading-relaxed">
            Formación especializada en arquitectura de software empresarial, modelado relacional ACID, especificación formal SDD y desarrollo ágil asistido por IA.
          </p>

          <div class="flex flex-wrap gap-1.5">
            {["Arquitectura SDD", "Bases de Datos Relacionales", "Sistemas Distribuidos", "Clean Architecture"].map((t) => (
              <span class="text-xs px-2.5 py-0.5 rounded-md bg-[var(--bg)] text-[var(--ink-secondary)] font-medium">
                {t}
              </span>
            ))}
          </div>
        </a>
      </div>

      <!-- Bottom Nav Links -->
      <div class="pt-4 flex items-center justify-between text-xs font-medium text-[var(--ink-muted)]">
        <a href="/profile" class="hover:text-[var(--accent)] transition-colors flex items-center gap-1 active:scale-95">
          Ver perfil académico <Icon name="arrow-right" class="w-3 h-3 text-[var(--ink-faint)]" />
        </a>
        <a href="/certificates" class="hover:text-[var(--accent)] transition-colors flex items-center gap-1 active:scale-95">
          Certificados oficiales <Icon name="arrow-right" class="w-3 h-3 text-[var(--ink-faint)]" />
        </a>
        <a href="/cv" class="hover:text-[var(--accent)] transition-colors flex items-center gap-1 active:scale-95">
          Referencia académica <Icon name="arrow-right" class="w-3 h-3 text-[var(--ink-faint)]" />
        </a>
      </div>
    </div>
  </div>
</section>
