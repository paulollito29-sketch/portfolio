---
import Icon from "./icons/Icon.astro";
---

<section id="facets" class="max-w-7xl mx-auto px-4 sm:px-8 py-10 relative z-10">
  <div class="grid lg:grid-cols-2 gap-7">
    <!-- Panel 1: Profesional (Glassmorphism + Subtle Gradient) -->
    <div class="glass-card p-6 sm:p-8 flex flex-col justify-between">
      <div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
          <h2 class="font-display font-bold text-xl sm:text-2xl tracking-tight text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-sky-400 to-indigo-500 shadow-sm shadow-sky-400/50"></span>
            Experiencia Profesional
          </h2>

          <div class="flex items-center gap-2">
            <a
              href="https://github.com/paulollito29-sketch"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-lg bg-white/[0.08] hover:bg-white/[0.15] text-white font-medium text-xs tracking-tight transition-[background-color,transform] duration-150 active:scale-95 flex items-center gap-1.5 border border-white/10"
            >
              <Icon name="github" class="w-3.5 h-3.5" /> GitHub
            </a>
            <a
              href="https://www.linkedin.com/in/paulo-espinoza9/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-lg bg-gradient-to-r from-sky-500/20 to-indigo-500/20 hover:from-sky-500/30 hover:to-indigo-500/30 text-sky-300 font-medium text-xs tracking-tight transition-[background-color,transform] duration-150 active:scale-95 flex items-center gap-1.5 border border-sky-400/30"
            >
              <Icon name="linkedin" class="w-3.5 h-3.5 text-sky-400" /> LinkedIn
            </a>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-6">
          8 meses de experiencia comprobada en desarrollo Full Stack y optimización SQL en entornos institucionales de alta exigencia.
        </p>

        <!-- Air Force Work Experience Card -->
        <a href="/cv" class="block rounded-xl bg-white/[0.03] p-5 mb-6 border border-white/[0.08] hover:border-sky-400/40 hover:bg-white/[0.05] transition-[border-color,background-color,transform] duration-150 group active:scale-[0.99]">
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xs font-semibold text-sky-400 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
              Servicio de Informática de la Fuerza Aérea
            </span>
            <span class="text-xs text-zinc-400 font-medium">Ene – Ago 2026</span>
          </div>

          <h3 class="text-base font-bold text-white mb-1.5 group-hover:text-sky-300 transition-colors duration-150">
            Programador Full Stack &amp; SQL
          </h3>
          <p class="text-xs text-zinc-300 line-clamp-2 mb-3.5 leading-relaxed">
            Diseño y desarrollo de módulos backend escalables con Java y Spring Boot (Spring Data JPA), interfaces web dinámicas en React.js y consultas SQL avanzadas para datos operativos críticos.
          </p>

          <div class="flex flex-wrap gap-1.5">
            {["Java", "Spring Boot", "Spring Data JPA", "React.js", "SQL", "Git"].map((t) => (
              <span class="text-[11px] px-2.5 py-0.5 rounded-md bg-white/[0.05] text-zinc-200 border border-white/[0.06]">
                {t}
              </span>
            ))}
          </div>
        </a>
      </div>

      <!-- Bottom Nav Links -->
      <div class="pt-4 border-t border-white/[0.08] flex items-center justify-between text-xs font-medium text-zinc-400">
        <a href="/cv" class="hover:text-sky-400 transition-colors flex items-center gap-1 active:scale-95">
          Ver CV Completo <Icon name="arrow-right" class="w-3 h-3 text-sky-400" />
        </a>
        <a href="/portfolio" class="hover:text-sky-400 transition-colors flex items-center gap-1 active:scale-95">
          Portafolio <Icon name="arrow-right" class="w-3 h-3 text-sky-400" />
        </a>
        <a href="/contact" class="hover:text-sky-400 transition-colors flex items-center gap-1 active:scale-95">
          Contacto <Icon name="arrow-right" class="w-3 h-3 text-sky-400" />
        </a>
      </div>
    </div>

    <!-- Panel 2: Académico & Acreditaciones -->
    <div class="glass-card p-6 sm:p-8 flex flex-col justify-between">
      <div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
          <h2 class="font-display font-bold text-xl sm:text-2xl tracking-tight text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-indigo-400 to-purple-500 shadow-sm shadow-purple-400/50"></span>
            Formación &amp; Acreditaciones
          </h2>

          <div class="flex items-center gap-2">
            <a
              href="/profile"
              class="px-3 py-1.5 rounded-lg bg-white/[0.08] hover:bg-white/[0.15] text-white font-medium text-xs tracking-tight transition-[background-color,transform] duration-150 active:scale-95 flex items-center gap-1.5 border border-white/10"
            >
              <Icon name="graduation-cap" class="w-3.5 h-3.5 text-sky-300" /> 7º Ciclo UPC
            </a>
            <a
              href="/certificates"
              class="px-3 py-1.5 rounded-lg bg-gradient-to-r from-purple-500/20 to-pink-500/20 hover:from-purple-500/30 hover:to-pink-500/30 text-purple-300 font-medium text-xs tracking-tight transition-[background-color,transform] duration-150 active:scale-95 flex items-center gap-1.5 border border-purple-400/30"
            >
              <Icon name="award" class="w-3.5 h-3.5 text-purple-400" /> 10 PDFs Oficiales
            </a>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-6">
          Formación universitaria de rigor en la UPC respaldada por 10 certificaciones oficiales de Meta, Oracle Academy y University of Michigan.
        </p>

        <!-- Featured Academic & Reference Lead -->
        <a href="/certificates" class="block rounded-xl bg-white/[0.03] p-5 mb-6 border border-white/[0.08] hover:border-purple-400/40 hover:bg-white/[0.05] transition-[border-color,background-color,transform] duration-150 group active:scale-[0.99]">
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xs font-semibold text-purple-400 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
              Acreditaciones Verificables
            </span>
            <span class="text-xs text-zinc-400 font-medium">10 Certificados</span>
          </div>

          <h3 class="text-base font-bold text-white mb-1.5 group-hover:text-purple-300 transition-colors duration-150">
            Oracle Academy, Meta &amp; University of Michigan
          </h3>
          <p class="text-xs text-zinc-300 line-clamp-2 mb-3.5 leading-relaxed">
            Validación de competencias en bases de datos relacionales Oracle SQL, React, estructuras de datos avanzadas y desarrollo web con Python.
          </p>

          <div class="flex flex-wrap gap-1.5">
            {["Oracle SQL", "Meta React", "Data Structures", "Web Data & APIs", "Ref: Elio Navarrete"].map((t) => (
              <span class="text-[11px] px-2.5 py-0.5 rounded-md bg-white/[0.05] text-zinc-200 border border-white/[0.06]">
                {t}
              </span>
            ))}
          </div>
        </a>
      </div>

      <!-- Bottom Nav Links -->
      <div class="pt-4 border-t border-white/[0.08] flex items-center justify-between text-xs font-medium text-zinc-400">
        <a href="/certificates" class="hover:text-purple-400 transition-colors flex items-center gap-1 active:scale-95">
          Ver 10 Certificados <Icon name="arrow-right" class="w-3 h-3 text-purple-400" />
        </a>
        <a href="/profile" class="hover:text-purple-400 transition-colors flex items-center gap-1 active:scale-95">
          Perfil Académico <Icon name="arrow-right" class="w-3 h-3 text-purple-400" />
        </a>
        <a href="/cv" class="hover:text-purple-400 transition-colors flex items-center gap-1 active:scale-95">
          Curriculum Vitae <Icon name="arrow-right" class="w-3 h-3 text-purple-400" />
        </a>
      </div>
    </div>
  </div>
</section>
