---
import Icon from "./icons/Icon.astro";
---

<section id="facets" class="max-w-7xl mx-auto px-4 sm:px-8 py-10 relative z-10">
  <div class="grid lg:grid-cols-2 gap-6">
    <!-- Panel 1: Profesional -->
    <div class="bg-[#10121a] border border-[#1d2230] rounded-lg p-6 sm:p-7 flex flex-col justify-between hover:border-[#2a3247] transition-[border-color] duration-150">
      <div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
          <h2 class="font-display font-bold text-xl sm:text-2xl tracking-tight text-white">
            Trayectoria Profesional
          </h2>

          <div class="flex items-center gap-2">
            <a
              href="https://github.com/paulollito29-sketch"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-md bg-white text-zinc-950 font-semibold text-xs tracking-tight transition-[background-color,transform] duration-150 hover:bg-sky-400 active:scale-95 flex items-center gap-1.5"
            >
              <Icon name="github" class="w-3.5 h-3.5" /> GitHub
            </a>
            <a
              href="https://www.linkedin.com/in/paulo-espinoza9/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-md bg-[#181b24] hover:bg-[#202533] text-zinc-200 font-medium text-xs tracking-tight transition-[background-color,transform] duration-150 active:scale-95 flex items-center gap-1.5"
            >
              <Icon name="linkedin" class="w-3.5 h-3.5 text-sky-400" /> LinkedIn
            </a>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-6">
          Diseño e implementación de sistemas backend de producción, microservicios en Java (Spring Boot) &amp; .NET y persistencia transaccional.
        </p>

        <!-- Featured Project Lead -->
        <a href="/portfolio" class="block rounded-lg bg-[#0a0b10] p-4 sm:p-5 mb-6 border border-[#1c212e] hover:border-sky-500/40 transition-[border-color,transform] duration-150 group active:scale-[0.99]">
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xs font-semibold text-sky-400">
              Sistemas Empresariales
            </span>
            <span class="text-xs text-zinc-500">2026</span>
          </div>

          <h3 class="text-sm sm:text-base font-bold text-white mb-1.5 group-hover:text-sky-400 transition-colors duration-150">
            Vault Vintage &amp; Store Backend Ecosystem
          </h3>
          <p class="text-xs text-zinc-400 line-clamp-2 mb-3 leading-relaxed">
            Arquitectura de servicios desacoplados, autenticación stateless con JWT, persistencia transaccional en SQL Server y especificaciones REST documentadas.
          </p>

          <div class="flex flex-wrap gap-1.5">
            {["Java", "Spring Boot", "SQL Server", "JWT", "Docker"].map((t) => (
              <span class="text-[11px] px-2 py-0.5 rounded bg-[#131620] text-zinc-300">
                {t}
              </span>
            ))}
          </div>
        </a>
      </div>

      <!-- Bottom Nav Links -->
      <div class="pt-4 border-t border-[#181d29] flex items-center justify-between text-xs font-medium text-zinc-400">
        <a href="/portfolio" class="hover:text-sky-400 transition-colors flex items-center gap-1 active:scale-95">
          Ver Portafolio <Icon name="arrow-right" class="w-3 h-3" />
        </a>
        <a href="/services" class="hover:text-sky-400 transition-colors flex items-center gap-1 active:scale-95">
          Servicios <Icon name="arrow-right" class="w-3 h-3" />
        </a>
        <a href="/contact" class="hover:text-sky-400 transition-colors flex items-center gap-1 active:scale-95">
          Contacto <Icon name="arrow-right" class="w-3 h-3" />
        </a>
      </div>
    </div>

    <!-- Panel 2: Académico -->
    <div class="bg-[#10121a] border border-[#1d2230] rounded-lg p-6 sm:p-7 flex flex-col justify-between hover:border-[#2a3247] transition-[border-color] duration-150">
      <div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
          <h2 class="font-display font-bold text-xl sm:text-2xl tracking-tight text-white">
            Formación &amp; Acreditaciones
          </h2>

          <div class="flex items-center gap-2">
            <a
              href="/profile"
              class="px-3 py-1.5 rounded-md bg-white text-zinc-950 font-semibold text-xs tracking-tight transition-[background-color,transform] duration-150 hover:bg-sky-400 active:scale-95 flex items-center gap-1.5"
            >
              <Icon name="graduation-cap" class="w-3.5 h-3.5" /> UPC
            </a>
            <a
              href="/certificates"
              class="px-3 py-1.5 rounded-md bg-[#181b24] hover:bg-[#202533] text-zinc-200 font-medium text-xs tracking-tight transition-[background-color,transform] duration-150 active:scale-95 flex items-center gap-1.5"
            >
              <Icon name="award" class="w-3.5 h-3.5 text-sky-400" /> 10 Certificados
            </a>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-6">
          Ingeniería de Sistemas de Información en la UPC junto a acreditaciones oficiales de Meta, Oracle Academy y University of Michigan.
        </p>

        <!-- Featured Academic Lead -->
        <a href="/certificates" class="block rounded-lg bg-[#0a0b10] p-4 sm:p-5 mb-6 border border-[#1c212e] hover:border-sky-500/40 transition-[border-color,transform] duration-150 group active:scale-[0.99]">
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xs font-semibold text-sky-400">
              Acreditaciones Oficiales Verificables
            </span>
            <span class="text-xs text-zinc-500">10 PDFs</span>
          </div>

          <h3 class="text-sm sm:text-base font-bold text-white mb-1.5 group-hover:text-sky-400 transition-colors duration-150">
            Oracle Academy, Meta &amp; University of Michigan
          </h3>
          <p class="text-xs text-zinc-400 line-clamp-2 mb-3 leading-relaxed">
            10 certificaciones completas que respaldan competencias en bases de datos relacionales Oracle SQL, React, estructuras de datos y APIs.
          </p>

          <div class="flex flex-wrap gap-1.5">
            {["Oracle SQL", "Meta React", "Data Structures", "Web Data & APIs", "Capstone"].map((t) => (
              <span class="text-[11px] px-2 py-0.5 rounded bg-[#131620] text-zinc-300">
                {t}
              </span>
            ))}
          </div>
        </a>
      </div>

      <!-- Bottom Nav Links -->
      <div class="pt-4 border-t border-[#181d29] flex items-center justify-between text-xs font-medium text-zinc-400">
        <a href="/certificates" class="hover:text-sky-400 transition-colors flex items-center gap-1 active:scale-95">
          Ver Certificados <Icon name="arrow-right" class="w-3 h-3" />
        </a>
        <a href="/profile" class="hover:text-sky-400 transition-colors flex items-center gap-1 active:scale-95">
          Perfil Académico <Icon name="arrow-right" class="w-3 h-3" />
        </a>
        <a href="/cv" class="hover:text-sky-400 transition-colors flex items-center gap-1 active:scale-95">
          Ver CV <Icon name="arrow-right" class="w-3 h-3" />
        </a>
      </div>
    </div>
  </div>
</section>
