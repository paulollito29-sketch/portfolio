---
import Icon from "./icons/Icon.astro";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/[0.08] bg-[#06070a]/85 backdrop-blur-xl text-zinc-400 py-14 px-4 sm:px-8 relative z-10 shadow-2xl">
  <div class="max-w-7xl mx-auto space-y-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      {/* Brand Column */}
      <div class="md:col-span-6 space-y-3.5">
        <div class="text-xl font-display font-extrabold tracking-tight gradient-text-hero">
          PAULO ESPINOZA
        </div>
        <p class="text-xs text-sky-400 font-semibold">
          Ingeniero de Sistemas de Información · Universidad Peruana de Ciencias Aplicadas (UPC)
        </p>
        <p class="text-xs text-zinc-300 max-w-md leading-relaxed">
          Diseño e implementación de microservicios backend en Java (Spring Boot) &amp; .NET, persistencia relacional en SQL Server y PostgreSQL, y desarrollo sistemático con metodología SDD y flujos asistidos por IA.
        </p>
      </div>

      {/* Navigation Column */}
      <div class="md:col-span-3 space-y-3">
        <span class="text-xs font-bold text-white uppercase tracking-wider block">
          Navegación
        </span>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/" class="hover:text-white transition-colors duration-150">Inicio</a>
          </li>
          <li>
            <a href="/profile" class="hover:text-white transition-colors duration-150">Perfil Oficial</a>
          </li>
          <li>
            <a href="/services" class="hover:text-white transition-colors duration-150">Servicios</a>
          </li>
          <li>
            <a href="/portfolio" class="hover:text-white transition-colors duration-150">Portafolio</a>
          </li>
          <li>
            <a href="/certificates" class="hover:text-white transition-colors duration-150">Certificaciones</a>
          </li>
          <li>
            <a href="/cv" class="hover:text-white transition-colors duration-150">Curriculum Vitae</a>
          </li>
          <li>
            <a href="/contact" class="hover:text-white transition-colors duration-150">Contacto</a>
          </li>
        </ul>
      </div>

      {/* Connect Column */}
      <div class="md:col-span-3 space-y-3">
        <span class="text-xs font-bold text-white uppercase tracking-wider block">
          Canales Directos
        </span>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a
              href="https://www.linkedin.com/in/paulo-espinoza9/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-sky-400 transition-colors duration-150 active:scale-95 text-zinc-300"
            >
              <Icon name="linkedin" class="w-3.5 h-3.5 text-sky-400" /> LinkedIn Profesional
            </a>
          </li>
          <li>
            <a
              href="https://github.com/paulollito29-sketch"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-white transition-colors duration-150 active:scale-95 text-zinc-300"
            >
              <Icon name="github" class="w-3.5 h-3.5" /> Repositorios GitHub
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/51906920958"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-emerald-400 transition-colors duration-150 active:scale-95 text-zinc-300"
            >
              <Icon name="phone" class="w-3.5 h-3.5 text-emerald-400" /> WhatsApp Directo
            </a>
          </li>
          <li>
            <a
              href="mailto:pauloespinoza951@gmail.com"
              class="inline-flex items-center gap-2 hover:text-white transition-colors duration-150 active:scale-95 text-zinc-300"
            >
              <Icon name="mail" class="w-3.5 h-3.5 text-sky-400" /> pauloespinoza951@gmail.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="pt-6 border-t border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-zinc-400">
      <div>
        &copy; {currentYear} Paulo Daniel Espinoza Gamboa. Todos los derechos reservados.
      </div>
      <div>
        <span>Ingeniería de Sistemas de Información · UPC Lima, Perú</span>
      </div>
    </div>
  </div>
</footer>
