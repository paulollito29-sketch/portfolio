---
import Icon from "./icons/Icon.astro";
---

<section id="contact" class="max-w-7xl mx-auto px-4 sm:px-8 py-12 relative z-10">
  <!-- Flat Header -->
  <div class="mb-10 text-center sm:text-left border-b border-zinc-800 pb-5">
    <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block mb-1">
      COMUNICACIÓN OFICIAL
    </span>
    <h2 class="text-2xl sm:text-4xl font-display font-bold text-white uppercase tracking-tight">
      Contacto &amp; Contrataciones
    </h2>
    <p class="text-xs sm:text-sm text-zinc-400 mt-1">
      Canal directo de reclutamiento con Paulo Espinoza · Ingeniero de Sistemas de Información.
    </p>
  </div>

  <div class="grid lg:grid-cols-12 gap-6 items-start">
    <!-- Recruiter Details Card (Flat) -->
    <div class="lg:col-span-5 bg-[#121215] border border-[#24324f] rounded-lg p-6 space-y-5">
      <div>
        <h3 class="font-display font-bold text-lg text-white uppercase mb-1">
          Disponibilidad de Contratación
        </h3>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Disponible para incorporación en roles de <strong class="text-white">Ingeniería de Sistemas, Backend y Desarrollo Full Stack</strong>.
        </p>
      </div>

      <!-- Recruitment Facts (Flat) -->
      <div class="space-y-2 p-3 rounded bg-[#09090b] border border-zinc-800 text-xs text-zinc-300 font-mono">
        <div class="flex items-center gap-2">
          <Icon name="clock" class="w-3.5 h-3.5 text-cyan-400 shrink-0" />
          <span><strong>Disponibilidad:</strong> Inmediata</span>
        </div>
        <div class="flex items-center gap-2">
          <Icon name="map-pin" class="w-3.5 h-3.5 text-cyan-400 shrink-0" />
          <span><strong>Modalidad:</strong> Remota o Híbrida (Lima, Perú)</span>
        </div>
        <div class="flex items-center gap-2">
          <Icon name="calendar" class="w-3.5 h-3.5 text-cyan-400 shrink-0" />
          <span><strong>Grado:</strong> Ing. de Sistemas de Información · UPC</span>
        </div>
      </div>

      <!-- Direct Channels (Flat) -->
      <div class="space-y-2">
        <a
          href="mailto:paulespinoza951@gmail.com"
          class="flex items-center gap-3 p-3 rounded bg-[#09090b] border border-zinc-800 hover:border-zinc-700 transition-colors group"
        >
          <div class="w-8 h-8 rounded bg-zinc-900 border border-zinc-800 flex items-center justify-center text-cyan-400">
            <Icon name="mail" class="w-4 h-4" />
          </div>
          <div>
            <div class="text-[10px] font-mono text-zinc-500 uppercase">Email Corporativo</div>
            <div class="text-xs font-bold text-white group-hover:text-cyan-400 transition-colors">
              paulespinoza951@gmail.com
            </div>
          </div>
        </a>

        <a
          href="https://wa.me/51906920958"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 p-3 rounded bg-[#09090b] border border-zinc-800 hover:border-zinc-700 transition-colors group"
        >
          <div class="w-8 h-8 rounded bg-zinc-900 border border-zinc-800 flex items-center justify-center text-emerald-400">
            <Icon name="phone" class="w-4 h-4" />
          </div>
          <div>
            <div class="text-[10px] font-mono text-zinc-500 uppercase">WhatsApp Directo</div>
            <div class="text-xs font-bold text-white group-hover:text-emerald-400 transition-colors">
              +51 906 920 958
            </div>
          </div>
        </a>
      </div>

      <!-- Social Network Buttons (Flat) -->
      <div class="flex gap-2 pt-1">
        <a
          href="https://www.linkedin.com/in/paulo-espinoza9/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 py-2 px-3 rounded bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 text-xs font-mono font-medium text-white flex items-center justify-center gap-1.5 transition-colors uppercase"
        >
          <Icon name="linkedin" class="w-3.5 h-3.5 text-cyan-400" /> LinkedIn
        </a>

        <a
          href="https://github.com/paulollito29-sketch"
          target="_blank"
          rel="noopener noreferrer"
          class="py-2 px-3 rounded bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 text-xs font-mono font-medium text-zinc-300 hover:text-white flex items-center justify-center gap-1.5 transition-colors uppercase"
        >
          <Icon name="github" class="w-3.5 h-3.5" /> GitHub
        </a>
      </div>
    </div>

    <!-- Form Side (Flat) -->
    <div class="lg:col-span-7 bg-[#121215] border border-[#24324f] rounded-lg p-6">
      <form id="recruiterContactForm" class="space-y-3.5">
        <div class="grid sm:grid-cols-2 gap-3">
          <div>
            <label for="contactName" class="block text-xs font-mono uppercase text-zinc-400 mb-1">
              Nombre del Contacto *
            </label>
            <input
              id="contactName"
              name="name"
              type="text"
              required
              placeholder="Ej. Carlos Mendoza"
              class="w-full px-3 py-2 rounded bg-[#09090b] border border-zinc-800 focus:border-cyan-500 text-xs text-white placeholder:text-zinc-600 transition-colors outline-none"
            />
          </div>

          <div>
            <label for="contactCompany" class="block text-xs font-mono uppercase text-zinc-400 mb-1">
              Empresa u Organización
            </label>
            <input
              id="contactCompany"
              name="company"
              type="text"
              placeholder="Ej. Tech Enterprise"
              class="w-full px-3 py-2 rounded bg-[#09090b] border border-zinc-800 focus:border-cyan-500 text-xs text-white placeholder:text-zinc-600 transition-colors outline-none"
            />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-3">
          <div>
            <label for="contactEmail" class="block text-xs font-mono uppercase text-zinc-400 mb-1">
              Correo Electrónico *
            </label>
            <input
              id="contactEmail"
              name="email"
              type="email"
              required
              placeholder="contacto@empresa.com"
              class="w-full px-3 py-2 rounded bg-[#09090b] border border-zinc-800 focus:border-cyan-500 text-xs text-white placeholder:text-zinc-600 transition-colors outline-none"
            />
          </div>

          <div>
            <label for="contactReason" class="block text-xs font-mono uppercase text-zinc-400 mb-1">
              Motivo de Contacto
            </label>
            <select
              id="contactReason"
              name="reason"
              class="w-full px-3 py-2 rounded bg-[#09090b] border border-zinc-800 focus:border-cyan-500 text-xs text-white transition-colors outline-none"
            >
              <option value="Oportunidad Laboral / Sistemas">Oportunidad Laboral / Contratación</option>
              <option value="Entrevista Técnica">Coordinar Entrevista Técnica</option>
              <option value="Consultoría de Sistemas">Consultoría / Proyecto</option>
              <option value="Consulta General">Consulta General</option>
            </select>
          </div>
        </div>

        <div>
          <label for="contactMessage" class="block text-xs font-mono uppercase text-zinc-400 mb-1">
            Mensaje o Requerimiento *
          </label>
          <textarea
            id="contactMessage"
            name="message"
            required
            rows="4"
            placeholder="Describe el rol, proyecto o propuesta..."
            class="w-full px-3 py-2 rounded bg-[#09090b] border border-zinc-800 focus:border-cyan-500 text-xs text-white placeholder:text-zinc-600 transition-colors outline-none resize-none"
          ></textarea>
        </div>

        <button
          id="contactSubmitBtn"
          type="submit"
          class="w-full py-3 px-5 rounded font-mono font-bold text-xs uppercase tracking-wider transition-colors flex items-center justify-center gap-2 cursor-pointer bg-white hover:bg-cyan-400 text-black disabled:opacity-75"
        >
          <span id="btnIconWrapper">
            <Icon name="send" class="w-3.5 h-3.5" />
          </span>
          <span id="btnText">Enviar Mensaje Directo</span>
        </button>

        <div id="formFeedback" class="hidden p-3 rounded bg-emerald-950/40 border border-emerald-500/30 text-emerald-400 text-xs font-mono flex items-center gap-2">
          <Icon name="check-circle-2" class="w-4 h-4 shrink-0" />
          <span>¡Mensaje enviado con éxito! Me comunicaré a la brevedad posible.</span>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  function initContactForm() {
    const form = document.getElementById("recruiterContactForm") as HTMLFormElement | null;
    const submitBtn = document.getElementById("contactSubmitBtn") as HTMLButtonElement | null;
    const btnText = document.getElementById("btnText");
    const feedback = document.getElementById("formFeedback");

    if (!form || !submitBtn) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const nameInput = form.querySelector<HTMLInputElement>("#contactName");
      const emailInput = form.querySelector<HTMLInputElement>("#contactEmail");
      const messageInput = form.querySelector<HTMLTextAreaElement>("#contactMessage");

      if (!nameInput?.value || !emailInput?.value || !messageInput?.value) return;

      submitBtn.disabled = true;
      if (btnText) btnText.textContent = "Enviando mensaje...";

      // Simulate asynchronous transmission
      await new Promise((resolve) => setTimeout(resolve, 800));

      if (btnText) btnText.textContent = "Mensaje Enviado con Éxito";
      submitBtn.className = "w-full py-3 px-5 rounded font-mono font-bold text-xs uppercase tracking-wider transition-colors flex items-center justify-center gap-2 bg-emerald-600 text-white";

      if (feedback) feedback.classList.remove("hidden");

      form.reset();

      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.className = "w-full py-3 px-5 rounded font-mono font-bold text-xs uppercase tracking-wider transition-colors flex items-center justify-center gap-2 cursor-pointer bg-white hover:bg-cyan-400 text-black disabled:opacity-75";
        if (btnText) btnText.textContent = "Enviar Mensaje Directo";
        if (feedback) feedback.classList.add("hidden");
      }, 5000);
    });
  }

  initContactForm();
  document.addEventListener("astro:page-load", initContactForm);
</script>
