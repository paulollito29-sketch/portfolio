---
import Icon from "./icons/Icon.astro";
---

<section id="contact" class="max-w-7xl mx-auto px-4 sm:px-8 py-12 relative z-10 space-y-10">
  <div class="space-y-2">
    <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">
      Contacto y contrataciones
    </h2>
    <p class="text-xs sm:text-sm text-zinc-300 max-w-2xl leading-relaxed">
      Canal directo para coordinar entrevistas técnicas, oportunidades laborales o proyectos de sistemas.
    </p>
  </div>

  <div class="grid lg:grid-cols-12 gap-7 items-start">
    <!-- Recruiter Details Card -->
    <div class="lg:col-span-5 bg-[#151515] rounded-lg p-6 sm:p-8 space-y-6">
      <div>
        <h3 class="font-display font-bold text-xl text-white mb-1.5">
          Disponibilidad de contratación
        </h3>
        <p class="text-base text-zinc-300 leading-relaxed">
          Disponible para incorporación inmediata en roles de <strong class="text-white font-semibold">Ingeniería de Sistemas, Backend en Java (Spring Boot) o Full Stack</strong>.
        </p>
      </div>

      <!-- Recruitment Facts -->
      <div class="space-y-3 p-5 rounded bg-[#1c1c1c] text-base text-zinc-200">
        <div class="flex items-center gap-2.5">
          <Icon name="clock" class="w-4 h-4 text-emerald-400 shrink-0" />
          <span><strong>Disponibilidad:</strong> Inmediata (Open to Work)</span>
        </div>
        <div class="flex items-center gap-2.5">
          <Icon name="map-pin" class="w-4 h-4 text-zinc-400 shrink-0" />
          <span><strong>Modalidad:</strong> Remota o Híbrida (Lima, Perú)</span>
        </div>
        <div class="flex items-center gap-2.5">
          <Icon name="calendar" class="w-4 h-4 text-zinc-400 shrink-0" />
          <span><strong>Grado:</strong> Ing. de Sistemas de Información · 7º Ciclo UPC</span>
        </div>
      </div>

      <!-- Direct Channels -->
      <div class="space-y-3">
        <a
          href="mailto:pauloespinoza951@gmail.com"
          class="flex items-center gap-3.5 p-4 rounded bg-[#1c1c1c] hover:bg-[#222222] transition-colors group"
        >
          <div class="w-8 h-8 rounded bg-[#262626] flex items-center justify-center text-zinc-200">
            <Icon name="mail" class="w-4 h-4" />
          </div>
          <div>
            <div class="text-xs text-zinc-400">Email corporativo</div>
            <div class="text-base font-bold text-white group-hover:text-zinc-200 transition-colors">
              pauloespinoza951@gmail.com
            </div>
          </div>
        </a>

        <a
          href="https://wa.me/51906920958"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3.5 p-4 rounded bg-[#1c1c1c] hover:bg-[#222222] transition-colors group"
        >
          <div class="w-8 h-8 rounded bg-[#262626] flex items-center justify-center text-emerald-400">
            <Icon name="phone" class="w-4 h-4" />
          </div>
          <div>
            <div class="text-xs text-zinc-400">WhatsApp oficial</div>
            <div class="text-base font-bold text-white group-hover:text-emerald-300 transition-colors">
              Iniciar conversación en WhatsApp &rarr;
            </div>
          </div>
        </a>
      </div>

      <!-- Social Network Buttons -->
      <div class="flex gap-3 pt-1">
        <a
          href="https://www.linkedin.com/in/paulo-espinoza9/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 py-2.5 px-3 rounded bg-[#202020] hover:bg-[#282828] text-xs font-semibold text-white flex items-center justify-center gap-2 transition-colors"
        >
          <Icon name="linkedin" class="w-3.5 h-3.5" /> LinkedIn
        </a>

        <a
          href="https://github.com/paulollito29-sketch"
          target="_blank"
          rel="noopener noreferrer"
          class="py-2.5 px-4 rounded bg-[#202020] hover:bg-[#282828] text-xs font-semibold text-zinc-200 hover:text-white flex items-center justify-center gap-2 transition-colors"
        >
          <Icon name="github" class="w-3.5 h-3.5" /> GitHub
        </a>
      </div>
    </div>

    <!-- Form Side -->
    <div class="lg:col-span-7 bg-[#151515] rounded-lg p-6 sm:p-8">
      <form id="recruiterContactForm" class="space-y-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="contactName" class="block text-xs font-medium text-zinc-300 mb-1.5">
              Nombre o Reclutador *
            </label>
            <input
              id="contactName"
              name="name"
              type="text"
              required
              placeholder="Ej. Carlos Mendoza"
              class="w-full px-3.5 py-2.5 rounded bg-[#101010] border border-[#242424] focus:border-zinc-400 text-xs text-white placeholder:text-zinc-400 transition-colors outline-none"
            />
          </div>

          <div>
            <label for="contactCompany" class="block text-xs font-medium text-zinc-300 mb-1.5">
              Empresa u Organización
            </label>
            <input
              id="contactCompany"
              name="company"
              type="text"
              placeholder="Ej. Tech Enterprise"
              class="w-full px-3.5 py-2.5 rounded bg-[#101010] border border-[#242424] focus:border-zinc-400 text-xs text-white placeholder:text-zinc-400 transition-colors outline-none"
            />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="contactEmail" class="block text-xs font-medium text-zinc-300 mb-1.5">
              Correo Electrónico *
            </label>
            <input
              id="contactEmail"
              name="email"
              type="email"
              required
              placeholder="contacto@empresa.com"
              class="w-full px-3.5 py-2.5 rounded bg-[#101010] border border-[#242424] focus:border-zinc-400 text-xs text-white placeholder:text-zinc-400 transition-colors outline-none"
            />
          </div>

          <div>
            <label for="contactReason" class="block text-xs font-medium text-zinc-300 mb-1.5">
              Motivo de Contacto
            </label>
            <select
              id="contactReason"
              name="reason"
              class="w-full px-3.5 py-2.5 rounded bg-[#101010] border border-[#242424] focus:border-zinc-400 text-xs text-white transition-colors outline-none"
            >
              <option value="Oportunidad Laboral / Sistemas">Oportunidad Laboral / Contratación</option>
              <option value="Entrevista Técnica">Coordinar Entrevista Técnica</option>
              <option value="Consultoría de Sistemas">Consultoría / Proyecto</option>
              <option value="Consulta General">Consulta General</option>
            </select>
          </div>
        </div>

        <div>
          <label for="contactMessage" class="block text-xs font-medium text-zinc-300 mb-1.5">
            Mensaje o Requerimiento Técnico *
          </label>
          <textarea
            id="contactMessage"
            name="message"
            rows="4"
            required
            placeholder="Describa el rol, perfil técnico requerido o detalles de la propuesta..."
            class="w-full px-3.5 py-2.5 rounded bg-[#101010] border border-[#242424] focus:border-zinc-400 text-xs text-white placeholder:text-zinc-400 transition-colors outline-none resize-none"
          ></textarea>
        </div>

        <div class="flex items-center justify-between pt-2">
          <span class="text-xs text-zinc-400">
            Respuesta garantizada en menos de 24 horas hábiles.
          </span>

          <button
            type="submit"
            id="submitBtn"
            class="btn-primary"
          >
            <Icon name="send" class="w-4 h-4" />
            <span id="btnText">Enviar propuesta</span>
          </button>
        </div>

        <div
          id="formStatusMessage"
          class="hidden p-3.5 rounded text-xs leading-relaxed"
          role="alert"
        ></div>
      </form>
    </div>
  </div>
</section>

<script>
  function setupContactForm() {
    const form = document.getElementById("recruiterContactForm") as HTMLFormElement | null;
    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement | null;
    const btnText = document.getElementById("btnText");
    const statusMsg = document.getElementById("formStatusMessage");

    if (!form || !submitBtn || !btnText || !statusMsg) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      btnText.textContent = "Preparando envío...";

      const formData = new FormData(form);
      const name = formData.get("name")?.toString() || "";
      const company = formData.get("company")?.toString() || "No especificada";
      const email = formData.get("email")?.toString() || "";
      const reason = formData.get("reason")?.toString() || "";
      const message = formData.get("message")?.toString() || "";

      const subject = encodeURIComponent(`[Portafolio] ${reason} - ${company} (${name})`);
      const body = encodeURIComponent(
        `Hola Paulo,\n\nMi nombre es ${name} de ${company}.\n\nMotivo: ${reason}\nCorreo de contacto: ${email}\n\nMensaje:\n${message}\n\nQuedo a la espera de tu respuesta.`
      );

      const mailtoUrl = `mailto:pauloespinoza951@gmail.com?subject=${subject}&body=${body}`;

      setTimeout(() => {
        window.location.href = mailtoUrl;

        statusMsg.className = "p-3.5 rounded text-xs leading-relaxed bg-[#1c281e] text-emerald-300 block";
        statusMsg.textContent = "Se ha abierto su cliente de correo predeterminado con los datos estructurados. También puede escribir directamente a pauloespinoza951@gmail.com";

        submitBtn.disabled = false;
        btnText.textContent = "Enviar propuesta";
        form.reset();
      }, 300);
    });
  }

  setupContactForm();
  document.addEventListener("astro:page-load", setupContactForm);
</script>
