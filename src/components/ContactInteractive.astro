---
import Icon from "./icons/Icon.astro";
---

<section id="contact" class="max-w-7xl mx-auto px-4 sm:px-8 py-12 relative z-10 space-y-10">
  <div class="space-y-2">
    <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">
      Contacto &amp; Contrataciones
    </h2>
    <p class="text-xs sm:text-sm text-zinc-400 max-w-2xl">
      Canal directo para coordinar entrevistas técnicas, oportunidades laborales o consultoría de sistemas.
    </p>
  </div>

  <div class="grid lg:grid-cols-12 gap-6 items-start">
    <!-- Recruiter Details Card -->
    <div class="lg:col-span-5 bg-[#10121a] border border-[#1d2230] rounded-lg p-6 space-y-5">
      <div>
        <h3 class="font-display font-bold text-lg text-white mb-1">
          Disponibilidad de Contratación
        </h3>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Disponible para incorporación inmediata en roles de <strong class="text-white">Ingeniería de Sistemas, Backend en Java / .NET o Desarrollo Full Stack</strong>.
        </p>
      </div>

      <!-- Recruitment Facts -->
      <div class="space-y-2.5 p-4 rounded-lg bg-[#0a0b10] border border-[#181d29] text-xs text-zinc-300">
        <div class="flex items-center gap-2.5">
          <Icon name="clock" class="w-4 h-4 text-sky-400 shrink-0" />
          <span><strong>Disponibilidad:</strong> Inmediata (Open to Work)</span>
        </div>
        <div class="flex items-center gap-2.5">
          <Icon name="map-pin" class="w-4 h-4 text-sky-400 shrink-0" />
          <span><strong>Modalidad:</strong> Remota o Híbrida (Lima, Perú)</span>
        </div>
        <div class="flex items-center gap-2.5">
          <Icon name="calendar" class="w-4 h-4 text-sky-400 shrink-0" />
          <span><strong>Grado:</strong> Ing. de Sistemas de Información · UPC</span>
        </div>
      </div>

      <!-- Direct Channels -->
      <div class="space-y-2.5">
        <a
          href="mailto:paulespinoza951@gmail.com"
          class="flex items-center gap-3 p-3.5 rounded-lg bg-[#0a0b10] border border-[#181d29] hover:border-sky-500/40 transition-[border-color] duration-150 group active:scale-[0.98]"
        >
          <div class="w-8 h-8 rounded-md bg-[#161922] flex items-center justify-center text-sky-400">
            <Icon name="mail" class="w-4 h-4" />
          </div>
          <div>
            <div class="text-[11px] text-zinc-400">Email Corporativo</div>
            <div class="text-xs font-semibold text-white group-hover:text-sky-400 transition-colors">
              paulespinoza951@gmail.com
            </div>
          </div>
        </a>

        <a
          href="https://wa.me/51906920958"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 p-3.5 rounded-lg bg-[#0a0b10] border border-[#181d29] hover:border-emerald-500/40 transition-[border-color] duration-150 group active:scale-[0.98]"
        >
          <div class="w-8 h-8 rounded-md bg-[#161922] flex items-center justify-center text-emerald-400">
            <Icon name="phone" class="w-4 h-4" />
          </div>
          <div>
            <div class="text-[11px] text-zinc-400">WhatsApp Directo</div>
            <div class="text-xs font-semibold text-white group-hover:text-emerald-400 transition-colors">
              +51 906 920 958
            </div>
          </div>
        </a>
      </div>

      <!-- Social Network Buttons -->
      <div class="flex gap-2.5 pt-1">
        <a
          href="https://www.linkedin.com/in/paulo-espinoza9/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 py-2 px-3 rounded-md bg-[#161922] hover:bg-[#202533] text-xs font-semibold text-white flex items-center justify-center gap-2 transition-[background-color,transform] duration-150 active:scale-95"
        >
          <Icon name="linkedin" class="w-3.5 h-3.5 text-sky-400" /> LinkedIn
        </a>

        <a
          href="https://github.com/paulollito29-sketch"
          target="_blank"
          rel="noopener noreferrer"
          class="py-2 px-4 rounded-md bg-[#161922] hover:bg-[#202533] text-xs font-semibold text-zinc-300 hover:text-white flex items-center justify-center gap-2 transition-[background-color,transform] duration-150 active:scale-95"
        >
          <Icon name="github" class="w-3.5 h-3.5" /> GitHub
        </a>
      </div>
    </div>

    <!-- Form Side -->
    <div class="lg:col-span-7 bg-[#10121a] border border-[#1d2230] rounded-lg p-6 sm:p-7">
      <form id="recruiterContactForm" class="space-y-4">
        <div class="grid sm:grid-cols-2 gap-3.5">
          <div>
            <label for="contactName" class="block text-xs font-medium text-zinc-300 mb-1.5">
              Nombre o Reclutador *
            </label>
            <input
              id="contactName"
              name="name"
              type="text"
              required
              placeholder="Ej. Carlos Mendoza"
              class="w-full px-3.5 py-2.5 rounded-md bg-[#0a0b10] border border-[#1e2330] focus:border-sky-400 text-xs text-white placeholder:text-zinc-600 transition-colors outline-none"
            />
          </div>

          <div>
            <label for="contactCompany" class="block text-xs font-medium text-zinc-300 mb-1.5">
              Empresa u Organización
            </label>
            <input
              id="contactCompany"
              name="company"
              type="text"
              placeholder="Ej. Tech Enterprise"
              class="w-full px-3.5 py-2.5 rounded-md bg-[#0a0b10] border border-[#1e2330] focus:border-sky-400 text-xs text-white placeholder:text-zinc-600 transition-colors outline-none"
            />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-3.5">
          <div>
            <label for="contactEmail" class="block text-xs font-medium text-zinc-300 mb-1.5">
              Correo Electrónico *
            </label>
            <input
              id="contactEmail"
              name="email"
              type="email"
              required
              placeholder="contacto@empresa.com"
              class="w-full px-3.5 py-2.5 rounded-md bg-[#0a0b10] border border-[#1e2330] focus:border-sky-400 text-xs text-white placeholder:text-zinc-600 transition-colors outline-none"
            />
          </div>

          <div>
            <label for="contactReason" class="block text-xs font-medium text-zinc-300 mb-1.5">
              Motivo de Contacto
            </label>
            <select
              id="contactReason"
              name="reason"
              class="w-full px-3.5 py-2.5 rounded-md bg-[#0a0b10] border border-[#1e2330] focus:border-sky-400 text-xs text-white transition-colors outline-none"
            >
              <option value="Oportunidad Laboral / Sistemas">Oportunidad Laboral / Contratación</option>
              <option value="Entrevista Técnica">Coordinar Entrevista Técnica</option>
              <option value="Consultoría de Sistemas">Consultoría / Proyecto</option>
              <option value="Consulta General">Consulta General</option>
            </select>
          </div>
        </div>

        <div>
          <label for="contactMessage" class="block text-xs font-medium text-zinc-300 mb-1.5">
            Mensaje o Propuesta *
          </label>
          <textarea
            id="contactMessage"
            name="message"
            required
            rows="4"
            placeholder="Describe el rol, requerimiento técnico o propuesta..."
            class="w-full px-3.5 py-2.5 rounded-md bg-[#0a0b10] border border-[#1e2330] focus:border-sky-400 text-xs text-white placeholder:text-zinc-600 transition-colors outline-none resize-none"
          ></textarea>
        </div>

        <button
          id="contactSubmitBtn"
          type="submit"
          class="w-full py-3 px-5 rounded-md font-semibold text-xs transition-[background-color,transform] duration-150 flex items-center justify-center gap-2 cursor-pointer bg-white hover:bg-sky-400 text-zinc-950 active:scale-[0.98] disabled:opacity-75"
        >
          <span id="btnIconWrapper">
            <Icon name="send" class="w-3.5 h-3.5" />
          </span>
          <span id="btnText">Enviar Mensaje Directo</span>
        </button>

        <div id="formFeedback" class="hidden p-3 rounded-md bg-emerald-950/40 border border-emerald-500/30 text-emerald-400 text-xs flex items-center gap-2">
          <Icon name="check-circle-2" class="w-4 h-4 shrink-0" />
          <span>¡Mensaje transmitido con éxito! Me comunicaré a la brevedad posible.</span>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  function initContactForm() {
    const form = document.getElementById("recruiterContactForm") as HTMLFormElement | null;
    const submitBtn = document.getElementById("contactSubmitBtn") as HTMLButtonElement | null;
    const btnText = document.getElementById("btnText");
    const feedback = document.getElementById("formFeedback");

    if (!form || !submitBtn) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const nameInput = form.querySelector<HTMLInputElement>("#contactName");
      const emailInput = form.querySelector<HTMLInputElement>("#contactEmail");
      const messageInput = form.querySelector<HTMLTextAreaElement>("#contactMessage");

      if (!nameInput?.value || !emailInput?.value || !messageInput?.value) return;

      submitBtn.disabled = true;
      if (btnText) btnText.textContent = "Transmitiendo...";

      await new Promise((resolve) => setTimeout(resolve, 600));

      if (btnText) btnText.textContent = "Mensaje Enviado con Éxito";
      submitBtn.className = "w-full py-3 px-5 rounded-md font-semibold text-xs flex items-center justify-center gap-2 bg-emerald-600 text-white";

      if (feedback) feedback.classList.remove("hidden");

      form.reset();

      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.className = "w-full py-3 px-5 rounded-md font-semibold text-xs transition-[background-color,transform] duration-150 flex items-center justify-center gap-2 cursor-pointer bg-white hover:bg-sky-400 text-zinc-950 active:scale-[0.98] disabled:opacity-75";
        if (btnText) btnText.textContent = "Enviar Mensaje Directo";
        if (feedback) feedback.classList.add("hidden");
      }, 4000);
    });
  }

  initContactForm();
  document.addEventListener("astro:page-load", initContactForm);
</script>
