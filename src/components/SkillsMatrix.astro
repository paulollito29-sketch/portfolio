---
import { getCollection } from "astro:content";
import Icon from "./icons/Icon.astro";

const skillEntries = await getCollection("skills").catch(() => []);
const sortedSkills = skillEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const categories = sortedSkills.map((entry) => ({
  id: entry.data.id,
  label: entry.data.label.es,
  icon: entry.data.icon,
  summary: entry.data.summary.es,
  competencies: entry.data.competencies.map((comp: any) => ({
    name: comp.name,
    levelText: comp.levelText.es,
    levelPercent: comp.levelPercent,
    description: comp.description.es,
    tags: comp.tags,
  })),
}));
---

<section id="skills" class="py-12 px-4 sm:px-8 relative z-10 space-y-8">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="space-y-2">
      <h2 class="text-2xl sm:text-4xl font-display font-bold text-[var(--ink)] tracking-tight">
        Matriz de competencias técnicas
      </h2>
      <p class="text-sm sm:text-base text-[var(--ink-muted)] max-w-2xl leading-relaxed">
        Dominio práctico en arquitectura backend (Java y .NET), modelado relacional ACID y desarrollo web moderno asistido por IA.
      </p>
    </div>

    <!-- Tab Navigation -->
    <div class="flex flex-wrap gap-1 p-1 rounded-lg bg-[var(--surface-lift)] w-fit">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-tab={cat.id}
          class={`skill-tab-btn flex items-center gap-2 px-4 py-2 rounded-md text-xs font-medium tracking-tight transition-[background-color,color] duration-150 active:scale-95 cursor-pointer ${
            idx === 0
              ? "active bg-[var(--surface)] text-[var(--ink)] font-semibold"
              : "text-[var(--ink-muted)] hover:text-[var(--ink)] hover:bg-[var(--border-subtle)]"
          }`}
        >
          <Icon name={cat.icon} class="w-3.5 h-3.5" />
          <span>{cat.label}</span>
        </button>
      ))}
    </div>

    <!-- Competencies Panels with Solid Cards -->
    {categories.map((cat, idx) => (
      <div
        id={`skills-tab-${cat.id}`}
        data-tab-content={cat.id}
        class={`skill-panel grid md:grid-cols-2 gap-5 ${idx === 0 ? "grid" : "hidden"}`}
      >
        {cat.competencies.map((comp: any) => (
          <div class="bg-[var(--surface-card)] rounded-xl p-6 flex flex-col justify-between group card-hover-lift transition-colors duration-200">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <h3 class="text-base font-bold text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors">
                  {comp.name}
                </h3>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-md bg-[var(--surface-lift)] text-[var(--ink-secondary)]">
                  {comp.levelText}
                </span>
              </div>

              <p class="text-sm text-[var(--ink-secondary)] leading-relaxed mb-4">
                {comp.description}
              </p>

              <!-- Progress bar -->
              <div class="w-full bg-[var(--surface-lift)] h-2 rounded-full overflow-hidden mb-4">
                <div
                  class="h-full bg-[var(--accent)] rounded-full transition-[width] duration-500 ease-out"
                  style={`width: ${comp.levelPercent}%;`}
                ></div>
              </div>
            </div>

            <div class="flex flex-wrap gap-1.5 pt-3">
              {comp.tags.map((tag: string) => (
                <span class="px-2.5 py-0.5 text-xs rounded-md bg-[var(--surface-lift)] text-[var(--ink-secondary)] font-medium">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<script>
  function initSkillTabs() {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>(".skill-tab-btn");
    const panels = document.querySelectorAll<HTMLElement>(".skill-panel");

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const tab = btn.getAttribute("data-tab");

        tabBtns.forEach((b) => {
          b.className = "skill-tab-btn flex items-center gap-2 px-4 py-2 rounded-md text-xs font-medium tracking-tight transition-[background-color,color] duration-150 active:scale-95 cursor-pointer text-[var(--ink-muted)] hover:text-[var(--ink)] hover:bg-[var(--border-subtle)]";
        });
        btn.className = "skill-tab-btn flex items-center gap-2 px-4 py-2 rounded-md text-xs font-medium tracking-tight transition-[background-color,color] duration-150 active:scale-95 cursor-pointer active bg-[var(--surface)] text-[var(--ink)] font-semibold";

        panels.forEach((p) => {
          if (p.getAttribute("data-tab-content") === tab) {
            p.classList.remove("hidden");
            p.classList.add("grid");
          } else {
            p.classList.add("hidden");
            p.classList.remove("grid");
          }
        });
      });
    });
  }

  initSkillTabs();
  document.addEventListener("astro:page-load", initSkillTabs);
</script>
