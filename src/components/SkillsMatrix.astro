---
import { getCollection } from "astro:content";
import Icon from "./icons/Icon.astro";

const skillEntries = await getCollection("skills").catch(() => []);
const sortedSkills = skillEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const categories = sortedSkills.map((entry) => ({
  id: entry.data.id,
  label: entry.data.label.es,
  icon: entry.data.icon,
  summary: entry.data.summary.es,
  competencies: entry.data.competencies.map((comp) => ({
    name: comp.name,
    levelText: comp.levelText.es,
    levelPercent: comp.levelPercent,
    description: comp.description.es,
    tags: comp.tags,
  })),
}));
---

<section id="skills" class="py-12 px-4 sm:px-8 relative z-10">
  <div class="max-w-7xl mx-auto">
    <!-- Flat Section Header -->
    <div class="mb-10 text-center sm:text-left border-b border-zinc-800 pb-5">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block mb-1">
        STACK TECNOLÓGICO
      </span>
      <h2 class="text-2xl sm:text-4xl font-display font-bold text-white uppercase tracking-tight">
        Matriz de Competencias Técnicas
      </h2>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">
        Niveles de dominio en ingeniería de backend, persistencia de datos y desarrollo web.
      </p>
    </div>

    <!-- Tab Navigation (Flat) -->
    <div class="flex flex-wrap gap-1.5 mb-8 p-1 rounded bg-[#121215] border border-[#24324f] w-fit">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-tab={cat.id}
          class={`skill-tab-btn flex items-center gap-2 px-3.5 py-2 rounded text-xs font-mono tracking-wider transition-colors cursor-pointer uppercase ${
            idx === 0
              ? "active bg-zinc-800 text-white font-bold border border-zinc-700"
              : "text-zinc-400 hover:text-white hover:bg-zinc-900 border border-transparent"
          }`}
        >
          <Icon name={cat.icon} class="w-3.5 h-3.5" />
          <span>{cat.label}</span>
        </button>
      ))}
    </div>

    <!-- Competencies Panels (Flat) -->
    {categories.map((cat, idx) => (
      <div
        id={`skills-tab-${cat.id}`}
        data-tab-content={cat.id}
        class={`skill-panel grid md:grid-cols-2 gap-4 ${idx === 0 ? "grid" : "hidden"}`}
      >
        {cat.competencies.map((comp) => (
          <div class="bg-[#121215] border border-[#24324f] rounded-lg p-5 flex flex-col justify-between hover:border-zinc-700 transition-colors">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <h3 class="text-sm font-bold text-white">{comp.name}</h3>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-cyan-400 uppercase">
                  {comp.levelText}
                </span>
              </div>

              <p class="text-xs text-zinc-400 leading-relaxed mb-4">
                {comp.description}
              </p>

              <!-- Progress bar (Flat) -->
              <div class="w-full bg-zinc-900 h-1.5 rounded-full overflow-hidden border border-zinc-800 mb-4">
                <div
                  class="h-full bg-cyan-400 transition-all duration-300"
                  style={`width: ${comp.levelPercent}%;`}
                ></div>
              </div>
            </div>

            <div class="flex flex-wrap gap-1 pt-3 border-t border-zinc-800">
              {comp.tags.map((tag) => (
                <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-zinc-900 border border-zinc-800 text-zinc-300">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<script>
  function initSkillsTabs() {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>(".skill-tab-btn");
    const panels = document.querySelectorAll<HTMLElement>(".skill-panel");

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-tab");
        if (!targetId) return;

        tabBtns.forEach((b) => {
          b.classList.remove("active", "bg-zinc-800", "text-white", "font-bold", "border-zinc-700");
          b.classList.add("text-zinc-400", "hover:text-white", "hover:bg-zinc-900", "border-transparent");
        });

        btn.classList.add("active", "bg-zinc-800", "text-white", "font-bold", "border-zinc-700");
        btn.classList.remove("text-zinc-400", "hover:text-white", "hover:bg-zinc-900", "border-transparent");

        panels.forEach((p) => {
          if (p.getAttribute("data-tab-content") === targetId) {
            p.classList.remove("hidden");
            p.classList.add("grid");
          } else {
            p.classList.add("hidden");
            p.classList.remove("grid");
          }
        });
      });
    });
  }

  initSkillsTabs();
  document.addEventListener("astro:page-load", initSkillsTabs);
</script>
