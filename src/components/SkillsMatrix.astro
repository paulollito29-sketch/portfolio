---
import { getCollection } from "astro:content";
import Icon from "./icons/Icon.astro";

const skillEntries = await getCollection("skills").catch(() => []);
const sortedSkills = skillEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const categories = sortedSkills.map((entry) => ({
  id: entry.data.id,
  label: entry.data.label.es,
  icon: entry.data.icon,
  summary: entry.data.summary.es,
  competencies: entry.data.competencies.map((comp) => ({
    name: comp.name,
    levelText: comp.levelText.es,
    levelPercent: comp.levelPercent,
    description: comp.description.es,
    tags: comp.tags,
  })),
}));
---

<section id="skills" class="py-12 px-4 sm:px-8 relative z-10 space-y-8">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="space-y-2">
      <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">
        Matriz de Competencias Técnicas
      </h2>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-2xl">
        Dominio práctico en arquitectura backend, modelado relacional ACID y desarrollo web moderno.
      </p>
    </div>

    <!-- Tab Navigation -->
    <div class="flex flex-wrap gap-1.5 p-1 rounded-md bg-[#10121a] border border-[#1d2230] w-fit">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-tab={cat.id}
          class={`skill-tab-btn flex items-center gap-2 px-3.5 py-1.5 rounded text-xs font-medium tracking-tight transition-[background-color,color,transform] duration-150 active:scale-95 cursor-pointer ${
            idx === 0
              ? "active bg-zinc-800 text-white font-semibold"
              : "text-zinc-400 hover:text-white hover:bg-zinc-900/60"
          }`}
        >
          <Icon name={cat.icon} class="w-3.5 h-3.5" />
          <span>{cat.label}</span>
        </button>
      ))}
    </div>

    <!-- Competencies Panels -->
    {categories.map((cat, idx) => (
      <div
        id={`skills-tab-${cat.id}`}
        data-tab-content={cat.id}
        class={`skill-panel grid md:grid-cols-2 gap-4 ${idx === 0 ? "grid" : "hidden"}`}
      >
        {cat.competencies.map((comp) => (
          <div class="bg-[#10121a] border border-[#1d2230] rounded-lg p-5 flex flex-col justify-between hover:border-[#2b3347] transition-[border-color] duration-150">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <h3 class="text-sm font-bold text-white">{comp.name}</h3>
                <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-[#161922] text-sky-400">
                  {comp.levelText}
                </span>
              </div>

              <p class="text-xs text-zinc-400 leading-relaxed mb-4">
                {comp.description}
              </p>

              <!-- Progress bar -->
              <div class="w-full bg-[#181b24] h-1.5 rounded-full overflow-hidden mb-4">
                <div
                  class="h-full bg-sky-400 transition-[width] duration-300 ease-out"
                  style={`width: ${comp.levelPercent}%;`}
                ></div>
              </div>
            </div>

            <div class="flex flex-wrap gap-1.5 pt-3 border-t border-[#181d29]">
              {comp.tags.map((tag) => (
                <span class="px-2 py-0.5 text-[11px] rounded bg-[#161922] text-zinc-300">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<script>
  function initSkillsTabs() {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>(".skill-tab-btn");
    const panels = document.querySelectorAll<HTMLElement>(".skill-panel");

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-tab");
        if (!targetId) return;

        tabBtns.forEach((b) => {
          b.classList.remove("active", "bg-zinc-800", "text-white", "font-semibold");
          b.classList.add("text-zinc-400", "hover:text-white", "hover:bg-zinc-900/60");
        });

        btn.classList.add("active", "bg-zinc-800", "text-white", "font-semibold");
        btn.classList.remove("text-zinc-400", "hover:text-white", "hover:bg-zinc-900/60");

        panels.forEach((p) => {
          if (p.getAttribute("data-tab-content") === targetId) {
            p.classList.remove("hidden");
            p.classList.add("grid");
          } else {
            p.classList.add("hidden");
            p.classList.remove("grid");
          }
        });
      });
    });
  }

  initSkillsTabs();
  document.addEventListener("astro:page-load", initSkillsTabs);
</script>
