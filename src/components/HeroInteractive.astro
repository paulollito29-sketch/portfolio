---
import Icon from "./icons/Icon.astro";
---

<section id="hero" class="relative min-h-[85svh] flex flex-col justify-center pt-24 pb-16 px-4 sm:px-8 z-10">
  <div class="max-w-6xl mx-auto w-full space-y-8">
    <!-- Status Indicator (Plain solid pill without ping or glass) -->
    <div class="reveal-entry inline-flex items-center gap-2 px-3 py-1.5 rounded bg-[#1a1a1a] text-zinc-300 text-xs w-fit">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span class="font-medium">
        Disponible para contratación inmediata · 7º Ciclo UPC Lima, Perú
      </span>
    </div>

    <!-- Main Title & Value Proposition: 2 lines maximum at all widths -->
    <div class="space-y-4 max-w-4xl">
      <h1 class="reveal-entry reveal-delay-1 text-4xl sm:text-6xl lg:text-7xl font-display font-bold tracking-tight text-[#efefef] leading-tight">
        Paulo Espinoza
      </h1>
      <p class="reveal-entry reveal-delay-2 text-2xl sm:text-3xl text-zinc-300 font-medium">
        Ingeniero de Sistemas de Información (UPC)
      </p>

      <p class="reveal-entry reveal-delay-3 text-base sm:text-lg text-zinc-400 max-w-3xl leading-relaxed pt-1">
        Estudiante de 7º ciclo en la Universidad Peruana de Ciencias Aplicadas con 8 meses de experiencia como Full Stack Developer en el Servicio de Informática de la Fuerza Aérea. Especialista en microservicios backend en Java (Spring Boot), persistencia transaccional ACID (PostgreSQL y SQL Server) y arquitectura de software con metodología SDD.
      </p>

      <!-- Action Buttons (Solid colors with Emil Kowalski micro-feedback) -->
      <div class="reveal-entry reveal-delay-4 flex flex-wrap items-center gap-3 pt-3">
        <a href="/contact" class="btn-primary">
          <Icon name="briefcase" class="w-4 h-4" />
          <span>Contactar para entrevista</span>
        </a>

        <a href="/portfolio" class="btn-secondary">
          <span>Ver sistemas en producción</span>
          <Icon name="arrow-right" class="w-4 h-4 text-zinc-400" />
        </a>

        <a href="/cv" class="btn-secondary">
          <Icon name="file-text" class="w-4 h-4 text-zinc-400" />
          <span>Curriculum Vitae (PDF)</span>
        </a>
      </div>
    </div>

    <!-- Real Archival Systems Engineering Photograph -->
    <div class="reveal-entry reveal-delay-5 max-w-4xl overflow-hidden rounded-lg">
      <img
        src="/assets/technician-with-laptop-working-on-server-rack.jpg"
        width="1920"
        height="1275"
        alt="Ingeniería de sistemas e infraestructura de servidores en producción"
        class="w-full h-56 sm:h-72 object-cover rounded-lg hero-photo-drift"
        decoding="async"
      />
    </div>

    <!-- Authentic Systems Engineering Fragment (data-ui) with interactive live schema -->
    <div data-ui class="max-w-4xl p-5 sm:p-6 bg-[#121212] rounded-lg">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 mb-4">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#b11226]"></span>
          <span class="text-xs font-semibold text-white">
            Especificación técnica de sistemas y arquitectura
          </span>
        </div>
        <div class="text-xs text-zinc-400">
          Metodología SDD · Estándar de ingeniería UPC
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
        <div class="p-3 bg-[#181818] rounded space-y-1">
          <div class="text-zinc-400 text-xs font-medium">Núcleo backend</div>
          <div class="font-bold text-white text-sm">Java · Spring Boot</div>
          <div class="text-zinc-400 text-xs">C# · .NET Core · REST APIs</div>
        </div>
        <div class="p-3 bg-[#181818] rounded space-y-1">
          <div class="text-zinc-400 text-xs font-medium">Persistencia relacional</div>
          <div class="font-bold text-white text-sm">PostgreSQL · SQL Server</div>
          <div class="text-zinc-400 text-xs">Oracle SQL · ACID · JPA</div>
        </div>
        <div class="p-3 bg-[#181818] rounded space-y-1">
          <div class="text-zinc-400 text-xs font-medium">Trayectoria práctica</div>
          <div class="font-bold text-white text-sm">Fuerza Aérea (FAP)</div>
          <div class="text-zinc-400 text-xs">8 meses servicio de informática</div>
        </div>
        <div class="p-3 bg-[#181818] rounded space-y-1">
          <div class="text-zinc-400 text-xs font-medium">Frontend &amp; metodologías</div>
          <div class="font-bold text-white text-sm">React.js · Tailwind CSS</div>
          <div class="text-zinc-400 text-xs">SDD · OpenAPI · Flujos con IA</div>
        </div>
      </div>
    </div>
  </div>
</section>
