---
import Icon from "./icons/Icon.astro";
---

<section id="hero" class="relative min-h-[85svh] flex flex-col justify-center pt-28 pb-16 px-4 sm:px-8 z-10">
  <div class="max-w-6xl mx-auto w-full space-y-10">
    <!-- Status Indicator (Subtle, No Looping Ping) -->
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
      <span class="text-xs font-medium text-zinc-300 tracking-tight">
        Disponible para Contratación Inmediata · UPC Lima, Perú
      </span>
    </div>

    <!-- Main Title & Value Proposition -->
    <div class="space-y-6 max-w-4xl">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-extrabold tracking-tight text-white leading-[1.05]">
        Paulo Espinoza
        <span class="block text-2xl sm:text-4xl lg:text-5xl mt-2 font-semibold text-sky-400">
          Ingeniero de Sistemas de Información
        </span>
      </h1>

      <p class="text-base sm:text-lg text-zinc-300 max-w-3xl leading-relaxed">
        Graduado de la <strong class="text-white">Universidad Peruana de Ciencias Aplicadas (UPC)</strong>. Diseño e implementación de microservicios de alto rendimiento en <strong class="text-sky-300">Java (Spring Boot)</strong> y <strong class="text-white">C# (.NET)</strong>, persistencia relacional transaccional (PostgreSQL / SQL Server / Oracle) y desarrollo sistemático con metodología SDD.
      </p>

      <!-- Action Buttons with Emil Kowalski Micro-Feedback -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/contact"
          class="flat-btn-primary"
        >
          <Icon name="briefcase" class="w-4 h-4" />
          <span>Contactar para Entrevista</span>
        </a>

        <a
          href="/portfolio"
          class="flat-btn-outline"
        >
          <span>Ver Casos de Estudio</span>
          <Icon name="arrow-right" class="w-4 h-4 text-sky-400" />
        </a>

        <div class="flex items-center gap-2 pl-2">
          <a
            href="https://www.linkedin.com/in/paulo-espinoza9/"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-md bg-[#11131a] border border-[#202533] hover:border-sky-400 text-zinc-300 hover:text-white transition-[border-color,color,transform] duration-150 active:scale-95"
            aria-label="LinkedIn de Paulo Espinoza"
            title="LinkedIn Profesional"
          >
            <Icon name="linkedin" class="w-4 h-4 text-sky-400" />
          </a>

          <a
            href="https://github.com/paulollito29-sketch"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-md bg-[#11131a] border border-[#202533] hover:border-white text-zinc-300 hover:text-white transition-[border-color,color,transform] duration-150 active:scale-95"
            aria-label="GitHub de Paulo Espinoza"
            title="Repositorios GitHub"
          >
            <Icon name="github" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>

    <!-- Authentic Systems Engineering Fragment (data-ui) -->
    <div data-ui class="max-w-4xl p-5 sm:p-6 bg-[#0c0e14] border border-[#1e2330] rounded-lg">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-4 border-b border-[#1c212e]">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-sky-400"></span>
          <span class="text-xs font-semibold text-white tracking-tight">
            Arquitectura de Sistemas &amp; Stack de Producción
          </span>
        </div>
        <div class="text-[11px] text-zinc-400">
          Metodología SDD · UPC Engineering Standard
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
        <div class="space-y-1">
          <div class="text-zinc-500 uppercase tracking-wider text-[10px]">Núcleo Backend</div>
          <div class="font-semibold text-zinc-100">Java · Spring Boot</div>
          <div class="text-zinc-400 text-[11px]">C# · .NET Core · REST APIs</div>
        </div>
        <div class="space-y-1">
          <div class="text-zinc-500 uppercase tracking-wider text-[10px]">Persistencia Relacional</div>
          <div class="font-semibold text-zinc-100">PostgreSQL · SQL Server</div>
          <div class="text-zinc-400 text-[11px]">Oracle SQL · ACID · JPA/Hibernate</div>
        </div>
        <div class="space-y-1">
          <div class="text-zinc-500 uppercase tracking-wider text-[10px]">Frontend &amp; Delivery</div>
          <div class="font-semibold text-zinc-100">Astro · React · Next.js</div>
          <div class="text-zinc-400 text-[11px]">TypeScript · Tailwind CSS</div>
        </div>
        <div class="space-y-1">
          <div class="text-zinc-500 uppercase tracking-wider text-[10px]">Estandarización</div>
          <div class="font-semibold text-zinc-100">Spec-Driven Dev (SDD)</div>
          <div class="text-zinc-400 text-[11px]">Workflows con IA &amp; Git CI/CD</div>
        </div>
      </div>
    </div>
  </div>
</section>
