<div class="fixed inset-0 pointer-events-none -z-10 bg-[#07080d] overflow-hidden" aria-hidden="true">
  <!-- Glowing Gradient Mesh Orbs -->
  <div class="absolute -top-[15%] left-[10%] w-[550px] h-[550px] rounded-full bg-gradient-to-tr from-sky-600/25 via-indigo-600/20 to-purple-600/15 blur-[130px] opacity-70"></div>
  <div class="absolute top-[35%] -right-[10%] w-[650px] h-[650px] rounded-full bg-gradient-to-br from-indigo-600/20 via-purple-700/20 to-pink-600/10 blur-[150px] opacity-60"></div>
  <div class="absolute top-[75%] left-[5%] w-[600px] h-[600px] rounded-full bg-gradient-to-tr from-cyan-600/20 via-sky-600/15 to-blue-700/10 blur-[140px] opacity-65"></div>

  <!-- Geometric Subtle Grid Overlay for Engineering Texture -->
  <div 
    class="w-full h-full opacity-20 mix-blend-overlay"
    style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 40h40M40 0v40' fill='none' stroke='%2338bdf8' stroke-width='0.6' stroke-opacity='0.25'/%3E%3C/svg%3E&quot;); background-size: 40px 40px;"
  ></div>
</div>
