---
import Icon from "./icons/Icon.astro";
---

<button
  id="scrollToTopBtn"
  class="fixed bottom-6 right-6 z-40 p-3 rounded bg-[#1c1c1c] text-[#efefef] hover:bg-[#252525] transition-[opacity,transform,background-color] duration-150 active:scale-90 cursor-pointer opacity-0 pointer-events-none"
  aria-label="Volver arriba"
  title="Volver al inicio"
>
  <Icon name="arrow-up" class="w-4 h-4" />
</button>

<script>
  function initScrollToTop() {
    const btn = document.getElementById("scrollToTopBtn");
    if (!btn) return;

    const handleScroll = () => {
      if (window.scrollY > 400) {
        btn.classList.remove("opacity-0", "pointer-events-none");
        btn.classList.add("opacity-100", "pointer-events-auto");
      } else {
        btn.classList.add("opacity-0", "pointer-events-none");
        btn.classList.remove("opacity-100", "pointer-events-auto");
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
    handleScroll();
  }

  initScrollToTop();
  document.addEventListener("astro:page-load", initScrollToTop);
</script>
