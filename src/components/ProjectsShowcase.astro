---
import { getCollection } from "astro:content";
import Icon from "./icons/Icon.astro";

export interface Props {
  hideHeader?: boolean;
}

const { hideHeader = false } = Astro.props;

const projectEntries = await getCollection("projects").catch(() => []);
const sortedProjects = projectEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const featuredProject = sortedProjects.find((p) => p.data.featured)?.data || {
  title: "Vault Vintage & Store Backend Ecosystem",
  badge: { es: "Caso Destacado" },
  kicker: { es: "Caso Líder de Ingeniería de Sistemas" },
  summary: { es: "Plataforma empresarial integral que combina punto de venta, control de inventario transaccional y microservicios con seguridad JWT." },
  tags: ["Java", "Spring Boot", "SQL Server", "JWT Security", "Docker", "React"],
  points: {
    es: [
      "Diseño de persistencia transaccional en SQL Server con integridad referencial ACID.",
      "Seguridad perimetral mediante tokens JWT con control de expiración y roles.",
      "Documentación completa de endpoints con Swagger / OpenAPI 3.0 y contenedorización Docker."
    ]
  },
  repo: "https://github.com/paulollito29-sketch/store-backend-v2",
  frontendRepo: "https://github.com/paulollito29-sketch/vault-vintage-frontend"
};

// Filter out the lead project from the general grid cards
const portfolioCards = sortedProjects
  .filter((p) => p.id !== "vault-vintage-lead")
  .map((p) => p.data);

const categories = [
  { id: "all", label: "Todos los Casos" },
  { id: "backend", label: "Backend" },
  { id: "fullstack", label: "Full Stack" },
  { id: "database", label: "Bases de Datos & .NET" },
];
---

<section id="portfolios" class={`max-w-7xl mx-auto px-4 sm:px-8 ${hideHeader ? "pt-2 pb-12" : "py-12"} relative z-10`}>
  <!-- Section Header -->
  {!hideHeader && (
    <div class="mb-10 text-center sm:text-left border-b border-zinc-800 pb-5">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block mb-1">
        SISTEMAS DESARROLLADOS
      </span>
      <h2 class="text-2xl sm:text-4xl font-display font-bold text-white uppercase tracking-tight">
        Portafolio &amp; Casos de Estudio
      </h2>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">
        Proyectos empresariales con código fuente auditado y arquitecturas listas para producción.
      </p>
    </div>
  )}

  <!-- Lead Featured Case Study (Flat Friendly Slate) -->
  <div class="mb-10 rounded-xl bg-[#131d33] border border-[#24324f] p-6 sm:p-8">
    <div class="flex flex-col lg:flex-row items-start justify-between gap-6">
      <div class="flex-1 space-y-3">
        <div class="flex items-center gap-2">
          {featuredProject.badge?.es && (
            <span class="px-2.5 py-0.5 rounded bg-white text-slate-950 font-bold text-xs uppercase tracking-wider">
              {featuredProject.badge.es}
            </span>
          )}
          {featuredProject.kicker?.es && (
            <span class="text-xs font-mono text-slate-400">
              {featuredProject.kicker.es}
            </span>
          )}
        </div>

        <h3 class="text-xl sm:text-3xl font-display font-bold text-white uppercase">
          {featuredProject.title}
        </h3>

        {featuredProject.summary?.es && (
          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed max-w-3xl">
            {featuredProject.summary.es}
          </p>
        )}

        <!-- Tags -->
        <div class="flex flex-wrap gap-1.5 pt-1">
          {featuredProject.tags.map((t) => (
            <span class="px-2.5 py-0.5 text-xs font-mono rounded bg-zinc-900 border border-zinc-800 text-zinc-300">
              {t}
            </span>
          ))}
        </div>

        <!-- Points -->
        {featuredProject.points?.es && (
          <ul class="space-y-1.5 pt-2">
            {featuredProject.points.es.map((pt: string) => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-zinc-300">
                <Icon name="check-circle-2" class="w-4 h-4 text-cyan-400 shrink-0 mt-0.5" />
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        )}

        <!-- Actions -->
        <div class="flex flex-wrap items-center gap-3 pt-3">
          <a
            href={featuredProject.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded bg-white hover:bg-cyan-400 text-black font-semibold text-xs uppercase tracking-wider transition-colors flex items-center gap-2"
          >
            <Icon name="github" class="w-4 h-4" /> Repositorio Backend
          </a>
          {featuredProject.frontendRepo && (
            <a
              href={featuredProject.frontendRepo}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded bg-zinc-900 border border-zinc-700 hover:bg-zinc-800 text-white font-medium text-xs uppercase tracking-wider transition-colors flex items-center gap-2"
            >
              <Icon name="github" class="w-4 h-4" /> Repositorio Frontend
            </a>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Toolbar & Filters (Flat) -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-3 border-b border-zinc-800">
    <span class="text-xs font-mono uppercase tracking-wider text-zinc-400 font-bold">
      Filtrar por Área
    </span>

    <div class="flex flex-wrap gap-1.5" id="projectFilterGroup">
      {categories.map((c, idx) => (
        <button
          type="button"
          data-category={c.id}
          class={`project-filter-btn px-3 py-1 text-xs font-mono rounded transition-colors cursor-pointer uppercase tracking-wider ${
            idx === 0
              ? "active bg-zinc-800 text-white font-bold border border-zinc-600"
              : "bg-zinc-900 text-zinc-400 hover:text-white hover:bg-zinc-800 border border-zinc-800"
          }`}
        >
          {c.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Portfolio Grid -->
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5" id="projectsGrid">
    {portfolioCards.map((p) => (
      <article
        class="project-card bg-[#131d33] border border-[#24324f] rounded-xl p-5 flex flex-col justify-between hover:border-sky-500/50 hover:bg-[#1a2744] transition-all"
        data-project-category={p.category}
      >
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-900 text-sky-400 border border-[#24324f] uppercase">
              {p.categoryName.es}
            </span>
            <span class="text-xs font-mono text-slate-400">{p.year}</span>
          </div>

          <h4 class="text-sm sm:text-base font-bold text-white mb-2 line-clamp-2">
            {p.title}
          </h4>

          <p class="text-xs text-slate-300 leading-relaxed mb-3 line-clamp-3">
            {p.description.es}
          </p>

          <p class="text-[11px] font-mono text-slate-300 mb-4 border-l-2 border-sky-400 pl-2">
            {p.impact.es}
          </p>
        </div>

        <div>
          <div class="flex flex-wrap gap-1 mb-4">
            {p.tags.map((t) => (
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-900 text-zinc-400 border border-zinc-800">
                {t}
              </span>
            ))}
          </div>

          <div class="pt-3 border-t border-zinc-800">
            <a
              href={p.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-cyan-400 hover:text-cyan-300 transition-colors"
            >
              <Icon name="github" class="w-3.5 h-3.5" />
              <span>Ver en GitHub</span>
              <Icon name="arrow-right" class="w-3 h-3" />
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  function initProjectFilters() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>(".project-filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".project-card");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.getAttribute("data-category") || "all";

        filterBtns.forEach((b) => {
          b.className = "project-filter-btn px-3 py-1 text-xs font-mono rounded transition-colors cursor-pointer uppercase tracking-wider bg-zinc-900 text-zinc-400 hover:text-white hover:bg-zinc-800 border border-zinc-800";
        });
        btn.className = "project-filter-btn px-3 py-1 text-xs font-mono rounded transition-colors cursor-pointer uppercase tracking-wider active bg-zinc-800 text-white font-bold border border-zinc-600";

        cards.forEach((card) => {
          const cardCat = card.getAttribute("data-project-category");
          if (cat === "all" || cardCat === cat) {
            card.classList.remove("hidden");
            card.classList.add("flex");
          } else {
            card.classList.add("hidden");
            card.classList.remove("flex");
          }
        });
      });
    });
  }

  initProjectFilters();
  document.addEventListener("astro:page-load", initProjectFilters);
</script>
