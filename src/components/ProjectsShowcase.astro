---
import { getCollection } from "astro:content";
import Icon from "./icons/Icon.astro";

export interface Props {
  hideHeader?: boolean;
}

const { hideHeader = false } = Astro.props;

const projectEntries = await getCollection("projects").catch(() => []);
const sortedProjects = projectEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const featuredProject = sortedProjects.find((p) => p.data.featured)?.data || {
  title: "Vault Vintage & Store Backend Ecosystem",
  badge: { es: "Caso Destacado" },
  kicker: { es: "Ingeniería de Sistemas Backend" },
  summary: { es: "Plataforma empresarial que combina punto de venta transaccional, control de inventario con ACID y microservicios con autenticación JWT." },
  tags: ["Java", "Spring Boot", "SQL Server", "JWT Security", "Docker", "React"],
  points: {
    es: [
      "Persistencia transaccional en SQL Server con integridad referencial ACID.",
      "Seguridad perimetral mediante tokens JWT con control de expiración y roles.",
      "Documentación de contratos con OpenAPI 3.0 / Swagger y contenedorización Docker."
    ]
  },
  repo: "https://github.com/paulollito29-sketch/store-backend-v2",
  frontendRepo: "https://github.com/paulollito29-sketch/vault-vintage-frontend"
};

const portfolioCards = sortedProjects
  .filter((p) => p.id !== "vault-vintage-lead")
  .map((p) => p.data);

const categories = [
  { id: "all", label: "Todos los casos" },
  { id: "backend", label: "Backend core" },
  { id: "fullstack", label: "Full Stack" },
  { id: "database", label: "Bases de datos y .NET" },
];
---

<section id="portfolios" class={`max-w-7xl mx-auto px-4 sm:px-8 ${hideHeader ? "pt-2 pb-12" : "py-12"} relative z-10 space-y-10`}>
  {!hideHeader && (
    <div class="space-y-2">
      <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">
        Portafolio y casos de estudio
      </h2>
      <p class="text-xs sm:text-sm text-zinc-300 max-w-2xl leading-relaxed">
        Proyectos de ingeniería de sistemas de información con código auditado y arquitecturas listas para producción.
      </p>
    </div>
  )}

  <!-- Lead Featured Case Study (Solid Surface Container) -->
  <div class="bg-[#151515] rounded-lg p-6 sm:p-9 space-y-6">
    <div class="flex flex-col sm:flex-row gap-6 items-start">
      <img
        src="/assets/icl-trimetra-dy-server.jpg"
        width="1920"
        height="2880"
        alt="Servidor backend e infraestructura empresarial"
        class="w-full sm:w-1/3 h-52 object-cover rounded"
        loading="lazy"
        decoding="async"
      />
      <div class="flex-1 space-y-3">
        <h3 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight">
          {featuredProject.title}
        </h3>

        {featuredProject.summary?.es && (
          <p class="text-base sm:text-lg text-zinc-300 leading-relaxed">
            {featuredProject.summary.es}
          </p>
        )}

        <!-- Tags -->
        <div class="flex flex-wrap gap-2 pt-1">
          {featuredProject.tags.map((t: string) => (
            <span class="px-2.5 py-1 text-xs rounded bg-[#202020] text-zinc-300 font-medium">
              {t}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Points -->
    {featuredProject.points?.es && (
      <ul class="space-y-2 pt-2">
        {featuredProject.points.es.map((pt: string) => (
          <li class="flex items-start gap-2.5 text-base text-zinc-300">
            <span class="w-1.5 h-1.5 rounded-full bg-[#b11226] shrink-0 mt-2.5"></span>
            <span class="leading-relaxed">{pt}</span>
          </li>
        ))}
      </ul>
    )}

    <!-- Actions -->
    <div class="flex flex-wrap items-center gap-3 pt-4">
      <a
        href={featuredProject.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary text-xs"
      >
        <Icon name="github" class="w-4 h-4" />
        <span>Repositorio Backend</span>
      </a>
      {featuredProject.frontendRepo && (
        <a
          href={featuredProject.frontendRepo}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary text-xs"
        >
          <Icon name="github" class="w-4 h-4" />
          <span>Repositorio Frontend</span>
        </a>
      )}
    </div>
  </div>

  <!-- Toolbar & Filters -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2">
    <span class="text-xs font-semibold text-zinc-300">
      Casos por especialidad
    </span>

    <div class="flex flex-wrap gap-1 p-1 rounded bg-[#121212]" id="projectFilterGroup">
      {categories.map((c, idx) => (
        <button
          type="button"
          data-category={c.id}
          class={`project-filter-btn px-3 py-1.5 text-xs font-medium rounded transition-colors cursor-pointer active:scale-95 ${
            idx === 0
              ? "active bg-[#222222] text-white font-semibold"
              : "text-zinc-400 hover:text-white hover:bg-[#1a1a1a]"
          }`}
        >
          {c.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Portfolio Grid with Solid Surface Cards -->
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="projectsGrid">
    {portfolioCards.map((p) => (
      <article
        class="project-card bg-[#151515] rounded-lg p-6 flex flex-col justify-between group"
        data-project-category={p.category}
      >
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-[#202020] text-zinc-300">
              {p.categoryName.es}
            </span>
            <span class="text-xs text-zinc-400 font-medium">{p.year}</span>
          </div>

          <h3 class="text-lg font-bold text-white mb-2 line-clamp-2 group-hover:text-zinc-200 transition-colors">
            {p.title}
          </h3>

          <p class="text-base text-zinc-300 leading-relaxed mb-3.5">
            {p.description.es}
          </p>

          <p class="text-base text-zinc-400 mb-4 pl-3 leading-relaxed bg-[#1a1a1a] p-3 rounded">
            {p.impact.es}
          </p>
        </div>

        <div>
          <div class="flex flex-wrap gap-1.5 mb-4">
            {p.tags.map((t: string) => (
              <span class="text-xs px-2.5 py-0.5 rounded bg-[#202020] text-zinc-300">
                {t}
              </span>
            ))}
          </div>

          <div class="pt-2">
            <a
              href={p.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-200 hover:text-white transition-colors active:scale-95"
            >
              <span>Ver repositorio en GitHub &rarr;</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  function initProjectFilters() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>(".project-filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".project-card");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.getAttribute("data-category") || "all";

        filterBtns.forEach((b) => {
          b.className = "project-filter-btn px-3 py-1.5 text-xs font-medium rounded transition-colors cursor-pointer active:scale-95 text-zinc-400 hover:text-white hover:bg-[#1a1a1a]";
        });
        btn.className = "project-filter-btn px-3 py-1.5 text-xs font-medium rounded transition-colors cursor-pointer active:scale-95 active bg-[#222222] text-white font-semibold";

        cards.forEach((card) => {
          const cardCat = card.getAttribute("data-project-category");
          if (cat === "all" || cardCat === cat) {
            card.classList.remove("hidden");
            card.classList.add("flex");
          } else {
            card.classList.add("hidden");
            card.classList.remove("flex");
          }
        });
      });
    });
  }

  initProjectFilters();
  document.addEventListener("astro:page-load", initProjectFilters);
</script>
