---
import { getCollection } from "astro:content";
import Icon from "./icons/Icon.astro";

export interface Props {
  hideHeader?: boolean;
}

const { hideHeader = false } = Astro.props;

const projectEntries = await getCollection("projects").catch(() => []);
const sortedProjects = projectEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const featuredProject = sortedProjects.find((p) => p.data.featured)?.data || {
  title: "Vault Vintage & Store Backend Ecosystem",
  badge: { es: "Caso Destacado" },
  kicker: { es: "Ingeniería de Sistemas Backend" },
  summary: { es: "Plataforma empresarial que combina punto de venta transaccional, control de inventario con ACID y microservicios con autenticación JWT." },
  tags: ["Java", "Spring Boot", "SQL Server", "JWT Security", "Docker", "React"],
  points: {
    es: [
      "Persistencia transaccional en SQL Server con integridad referencial ACID.",
      "Seguridad perimetral mediante tokens JWT con control de expiración y roles.",
      "Documentación de contratos con OpenAPI 3.0 / Swagger y contenedorización Docker."
    ]
  },
  repo: "https://github.com/paulollito29-sketch/store-backend-v2",
  frontendRepo: "https://github.com/paulollito29-sketch/vault-vintage-frontend"
};

const portfolioCards = sortedProjects
  .filter((p) => p.id !== "vault-vintage-lead")
  .map((p) => p.data);

const categories = [
  { id: "all", label: "Todos los Casos" },
  { id: "backend", label: "Backend Core" },
  { id: "fullstack", label: "Full Stack" },
  { id: "database", label: "Bases de Datos & .NET" },
];
---

<section id="portfolios" class={`max-w-7xl mx-auto px-4 sm:px-8 ${hideHeader ? "pt-2 pb-12" : "py-12"} relative z-10 space-y-10`}>
  {!hideHeader && (
    <div class="space-y-2">
      <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">
        Portafolio &amp; Casos de Estudio
      </h2>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-2xl">
        Proyectos de ingeniería de sistemas con código auditado y arquitecturas listas para producción.
      </p>
    </div>
  )}

  <!-- Lead Featured Case Study -->
  <div class="rounded-lg bg-[#10121a] border border-[#1d2230] p-6 sm:p-8 space-y-5">
    <div class="flex flex-wrap items-center gap-2">
      {featuredProject.badge?.es && (
        <span class="px-2.5 py-0.5 rounded-md bg-white text-zinc-950 font-bold text-xs tracking-tight">
          {featuredProject.badge.es}
        </span>
      )}
      {featuredProject.kicker?.es && (
        <span class="text-xs text-sky-400 font-medium">
          {featuredProject.kicker.es}
        </span>
      )}
    </div>

    <h3 class="text-xl sm:text-3xl font-display font-bold text-white tracking-tight">
      {featuredProject.title}
    </h3>

    {featuredProject.summary?.es && (
      <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed max-w-3xl">
        {featuredProject.summary.es}
      </p>
    )}

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 pt-1">
      {featuredProject.tags.map((t) => (
        <span class="px-2.5 py-0.5 text-xs rounded bg-[#161922] text-zinc-300">
          {t}
        </span>
      ))}
    </div>

    <!-- Points -->
    {featuredProject.points?.es && (
      <ul class="space-y-2 pt-2">
        {featuredProject.points.es.map((pt: string) => (
          <li class="flex items-start gap-2 text-xs sm:text-sm text-zinc-300">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400 shrink-0 mt-1.5"></span>
            <span>{pt}</span>
          </li>
        ))}
      </ul>
    )}

    <!-- Actions -->
    <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-[#181d29]">
      <a
        href={featuredProject.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="flat-btn-primary active:scale-95 text-xs"
      >
        <Icon name="github" class="w-4 h-4" />
        <span>Repositorio Backend</span>
      </a>
      {featuredProject.frontendRepo && (
        <a
          href={featuredProject.frontendRepo}
          target="_blank"
          rel="noopener noreferrer"
          class="flat-btn-outline active:scale-95 text-xs"
        >
          <Icon name="github" class="w-4 h-4" />
          <span>Repositorio Frontend</span>
        </a>
      )}
    </div>
  </div>

  <!-- Toolbar & Filters -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2">
    <span class="text-xs font-semibold text-white tracking-tight">
      Casos por Especialidad
    </span>

    <div class="flex flex-wrap gap-1.5" id="projectFilterGroup">
      {categories.map((c, idx) => (
        <button
          type="button"
          data-category={c.id}
          class={`project-filter-btn px-3 py-1.5 text-xs font-medium rounded-md transition-[background-color,color,transform] duration-150 cursor-pointer active:scale-95 ${
            idx === 0
              ? "active bg-zinc-800 text-white font-semibold"
              : "bg-[#10121a] text-zinc-400 hover:text-white hover:bg-zinc-800/60"
          }`}
        >
          {c.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Portfolio Grid -->
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5" id="projectsGrid">
    {portfolioCards.map((p) => (
      <article
        class="project-card bg-[#10121a] border border-[#1d2230] rounded-lg p-5 flex flex-col justify-between hover:border-[#2b3347] transition-[border-color] duration-150"
        data-project-category={p.category}
      >
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-[#161922] text-sky-400">
              {p.categoryName.es}
            </span>
            <span class="text-xs text-zinc-500">{p.year}</span>
          </div>

          <h3 class="text-sm sm:text-base font-bold text-white mb-2 line-clamp-2">
            {p.title}
          </h3>

          <p class="text-xs text-zinc-400 leading-relaxed mb-3 line-clamp-3">
            {p.description.es}
          </p>

          <p class="text-[11px] text-zinc-300 mb-4 border-l-2 border-sky-400 pl-2">
            {p.impact.es}
          </p>
        </div>

        <div>
          <div class="flex flex-wrap gap-1.5 mb-4">
            {p.tags.map((t) => (
              <span class="text-[11px] px-2 py-0.5 rounded bg-[#161922] text-zinc-300">
                {t}
              </span>
            ))}
          </div>

          <div class="pt-3 border-t border-[#181d29]">
            <a
              href={p.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-sky-400 hover:text-sky-300 transition-colors active:scale-95"
            >
              <Icon name="github" class="w-3.5 h-3.5" />
              <span>Ver en GitHub</span>
              <Icon name="arrow-right" class="w-3 h-3" />
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  function initProjectFilters() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>(".project-filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".project-card");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.getAttribute("data-category") || "all";

        filterBtns.forEach((b) => {
          b.className = "project-filter-btn px-3 py-1.5 text-xs font-medium rounded-md transition-[background-color,color,transform] duration-150 cursor-pointer active:scale-95 bg-[#10121a] text-zinc-400 hover:text-white hover:bg-zinc-800/60";
        });
        btn.className = "project-filter-btn px-3 py-1.5 text-xs font-medium rounded-md transition-[background-color,color,transform] duration-150 cursor-pointer active:scale-95 active bg-zinc-800 text-white font-semibold";

        cards.forEach((card) => {
          const cardCat = card.getAttribute("data-project-category");
          if (cat === "all" || cardCat === cat) {
            card.classList.remove("hidden");
            card.classList.add("flex");
          } else {
            card.classList.add("hidden");
            card.classList.remove("flex");
          }
        });
      });
    });
  }

  initProjectFilters();
  document.addEventListener("astro:page-load", initProjectFilters);
</script>
