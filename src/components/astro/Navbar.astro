---
import { Github, Linkedin, Mail, Phone, Menu, X, ExternalLink, ShieldCheck, GraduationCap, Briefcase } from "lucide-react";

const navLinks = [
  { label: "Inicio", href: "#home" },
  { label: "Perfil", href: "#profile" },
  { label: "Paneles", href: "#facets" },
  { label: "Servicios", href: "#services" },
  { label: "Casos de Estudio", href: "#portfolios" },
  { label: "Certificaciones", href: "#certificates" },
  { label: "Contacto", href: "#contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#05070c]/90 backdrop-blur-md border-b border-white/5 transition-all" id="mainHeader">
  <!-- Glowing Neon Top Line -->
  <div class="nav-top-line">
    <span class="nav-top-line-glow top"></span>
    <span class="nav-top-line-glow bottom"></span>
  </div>

  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-8 py-3.5">
    <!-- Brand Logo with Divider -->
    <a href="#home" class="flex items-center gap-3 group">
      <div class="flex items-center gap-2">
        <span class="font-display font-bold text-base sm:text-lg tracking-widest text-white group-hover:text-cyan-400 transition-colors uppercase">
          PAULO ESPINOZA
        </span>
        <span class="text-zinc-600 font-light">|</span>
        <span class="text-[10px] font-mono text-cyan-400 tracking-wider hidden sm:inline-block uppercase">
          Ingeniero de Sistemas de Información · UPC
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3.5 py-1.5 text-xs font-mono tracking-wider text-zinc-400 hover:text-white hover:bg-white/5 rounded-md transition-all uppercase"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Utilities / Social Icons -->
    <div class="hidden sm:flex items-center gap-3">
      <div class="flex items-center gap-2 pr-3 border-r border-white/10">
        <a
          href="https://github.com/paulollito29-sketch"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded-lg text-zinc-400 hover:text-cyan-400 hover:bg-white/5 transition-colors"
          aria-label="GitHub"
          title="GitHub de Paulo Espinoza"
        >
          <Github className="w-4 h-4" />
        </a>
        <a
          href="https://www.linkedin.com/in/paulo-espinoza9/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded-lg text-zinc-400 hover:text-cyan-400 hover:bg-white/5 transition-colors"
          aria-label="LinkedIn"
          title="LinkedIn de Paulo Espinoza"
        >
          <Linkedin className="w-4 h-4" />
        </a>
        <a
          href="https://wa.me/51906920958"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded-lg text-zinc-400 hover:text-emerald-400 hover:bg-white/5 transition-colors"
          aria-label="WhatsApp"
          title="WhatsApp de Paulo Espinoza"
        >
          <Phone className="w-4 h-4" />
        </a>
        <a
          href="mailto:paulespinoza951@gmail.com"
          class="p-1.5 rounded-lg text-zinc-400 hover:text-sky-400 hover:bg-white/5 transition-colors"
          aria-label="Email"
          title="Email corporativo"
        >
          <Mail className="w-4 h-4" />
        </a>
      </div>

      <a
        href="#contact"
        class="px-3 py-1.5 rounded-md bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 text-xs font-mono tracking-wider transition-all uppercase"
      >
        Contacto
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button
      id="menuToggle"
      class="lg:hidden p-2 rounded-lg text-zinc-300 hover:text-white hover:bg-white/5 transition-colors"
      aria-label="Abrir menú de navegación"
    >
      <Menu className="w-5 h-5" />
    </button>
  </div>

  <!-- Mobile Overlay Menu (Elio Navarrete style with Dual Panels) -->
  <div
    id="mobileMenu"
    class="lg:hidden fixed inset-0 top-[57px] bg-[#05070c]/98 backdrop-blur-2xl border-t border-white/10 p-6 overflow-y-auto opacity-0 pointer-events-none transition-all duration-300 z-50 flex flex-col justify-between"
  >
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">
        <span class="font-mono text-xs text-cyan-400 uppercase tracking-widest flex items-center gap-2">
          <ShieldCheck className="w-4 h-4" /> Menú Oficial · Navegación
        </span>
        <button id="mobileMenuClose" class="p-1 text-zinc-400 hover:text-white" aria-label="Cerrar">
          <X className="w-5 h-5" />
        </button>
      </div>

      <ul class="space-y-3 mb-8">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-nav-link block py-2 px-3 text-base font-display font-semibold tracking-wider text-zinc-300 hover:text-cyan-400 hover:bg-white/5 rounded-lg transition-colors uppercase"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      {/* Dual Preview Panels inside Mobile Menu */}
      <div class="grid sm:grid-cols-2 gap-4 mb-8">
        <div class="p-4 rounded-xl bg-zinc-950 border border-white/10">
          <div class="flex items-center gap-2 text-xs font-mono text-cyan-400 mb-1.5 uppercase tracking-wider">
            <Briefcase className="w-3.5 h-3.5" /> Profesional
          </div>
          <p class="text-xs text-zinc-400 mb-3">
            Arquitectura de sistemas backend, microservicios en Spring Boot &amp; .NET y bases de datos relacionales.
          </p>
          <a href="#portfolios" class="mobile-nav-link text-xs font-mono text-white underline underline-offset-4 hover:text-cyan-400">
            Ver Portafolio →
          </a>
        </div>

        <div class="p-4 rounded-xl bg-zinc-950 border border-white/10">
          <div class="flex items-center gap-2 text-xs font-mono text-cyan-400 mb-1.5 uppercase tracking-wider">
            <GraduationCap className="w-3.5 h-3.5" /> Académico
          </div>
          <p class="text-xs text-zinc-400 mb-3">
            Formación en la UPC y acreditaciones oficiales por Meta, Oracle Academy y University of Michigan.
          </p>
          <a href="#certificates" class="mobile-nav-link text-xs font-mono text-white underline underline-offset-4 hover:text-cyan-400">
            Ver Certificaciones →
          </a>
        </div>
      </div>
    </div>

    <div class="pt-6 border-t border-white/10 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <a href="https://github.com/paulollito29-sketch" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-cyan-400">
          <Github className="w-4 h-4" />
        </a>
        <a href="https://www.linkedin.com/in/paulo-espinoza9/" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-cyan-400">
          <Linkedin className="w-4 h-4" />
        </a>
        <a href="mailto:paulespinoza951@gmail.com" class="text-zinc-400 hover:text-cyan-400">
          <Mail className="w-4 h-4" />
        </a>
      </div>
      <span class="text-[11px] font-mono text-zinc-500">© 2026 PAULO ESPINOZA</span>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("menuToggle");
  const closeBtn = document.getElementById("mobileMenuClose");
  const menu = document.getElementById("mobileMenu");
  const navLinks = document.querySelectorAll(".mobile-nav-link");

  function openMenu() {
    if (!menu) return;
    menu.classList.remove("opacity-0", "pointer-events-none");
    menu.classList.add("opacity-100", "pointer-events-auto");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    if (!menu) return;
    menu.classList.add("opacity-0", "pointer-events-none");
    menu.classList.remove("opacity-100", "pointer-events-auto");
    document.body.style.overflow = "";
  }

  toggleBtn?.addEventListener("click", () => {
    if (menu?.classList.contains("opacity-100")) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  closeBtn?.addEventListener("click", closeMenu);
  navLinks.forEach((link) => link.addEventListener("click", closeMenu));
</script>
