---
import { Github, Linkedin, Mail, Phone, Menu, X, ShieldCheck, GraduationCap, Briefcase } from "lucide-react";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { label: "Inicio", href: "/" },
  { label: "Perfil", href: "/profile" },
  { label: "Servicios", href: "/services" },
  { label: "Portafolio", href: "/portfolio" },
  { label: "Certificaciones", href: "/certificates" },
  { label: "Contacto", href: "/contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#0b1120]/90 backdrop-blur-md border-b border-slate-800/80 transition-all" id="mainHeader">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-8 py-3">
    <!-- Brand Logo with Flat Divider -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="flex items-center gap-2">
        <span class="font-display font-bold text-base sm:text-lg tracking-wider text-white group-hover:text-cyan-400 transition-colors uppercase">
          PAULO ESPINOZA
        </span>
        <span class="text-zinc-700 font-light">/</span>
        <span class="text-[11px] font-mono text-zinc-400 tracking-wider hidden sm:inline-block uppercase">
          Ingeniero de Sistemas · UPC
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links with Flat Active State -->
    <nav class="hidden lg:flex items-center gap-1">
      {navLinks.map((link) => {
        const isActive = (link.href === "/" && pathname === "/") || (link.href !== "/" && pathname.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 text-xs font-mono tracking-wider rounded transition-all uppercase ${
              isActive
                ? "bg-zinc-800 text-white font-bold border border-zinc-700"
                : "text-zinc-400 hover:text-white hover:bg-zinc-900"
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Utilities / Social Icons (Flat) -->
    <div class="hidden sm:flex items-center gap-3">
      <div class="flex items-center gap-1.5 pr-3 border-r border-zinc-800">
        <a
          href="https://github.com/paulollito29-sketch"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors"
          aria-label="GitHub"
          title="GitHub de Paulo Espinoza"
        >
          <Github className="w-4 h-4" />
        </a>
        <a
          href="https://www.linkedin.com/in/paulo-espinoza9/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded text-zinc-400 hover:text-cyan-400 hover:bg-zinc-800 transition-colors"
          aria-label="LinkedIn"
          title="LinkedIn de Paulo Espinoza"
        >
          <Linkedin className="w-4 h-4" />
        </a>
        <a
          href="https://wa.me/51906920958"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded text-zinc-400 hover:text-emerald-400 hover:bg-zinc-800 transition-colors"
          aria-label="WhatsApp"
          title="WhatsApp de Paulo Espinoza"
        >
          <Phone className="w-4 h-4" />
        </a>
        <a
          href="mailto:paulespinoza951@gmail.com"
          class="p-1.5 rounded text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors"
          aria-label="Email"
          title="Email corporativo"
        >
          <Mail className="w-4 h-4" />
        </a>
      </div>

      <a
        href="/contact"
        class={`px-3.5 py-1.5 rounded text-xs font-mono tracking-wider transition-all uppercase ${
          pathname === "/contact"
            ? "bg-white text-black font-bold"
            : "bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-zinc-800 hover:border-zinc-700"
        }`}
      >
        Contacto
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button
      id="menuToggle"
      class="lg:hidden p-2 rounded text-zinc-300 hover:text-white hover:bg-zinc-800 transition-colors"
      aria-label="Abrir menú de navegación"
    >
      <Menu className="w-5 h-5" />
    </button>
  </div>

  <!-- Mobile Overlay Menu (Flat Design) -->
  <div
    id="mobileMenu"
    class="lg:hidden fixed inset-0 top-[53px] bg-[#09090b] border-t border-zinc-800 p-6 overflow-y-auto opacity-0 pointer-events-none transition-opacity duration-200 z-50 flex flex-col justify-between"
  >
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-zinc-800 mb-6">
        <span class="font-mono text-xs text-zinc-400 uppercase tracking-widest flex items-center gap-2">
          <ShieldCheck className="w-4 h-4 text-cyan-400" /> Menú Oficial · Navegación
        </span>
        <button id="mobileMenuClose" class="p-1 text-zinc-400 hover:text-white" aria-label="Cerrar">
          <X className="w-5 h-5" />
        </button>
      </div>

      <ul class="space-y-2 mb-8">
        {navLinks.map((link) => {
          const isActive = (link.href === "/" && pathname === "/") || (link.href !== "/" && pathname.startsWith(link.href));
          return (
            <li>
              <a
                href={link.href}
                class={`mobile-nav-link block py-2.5 px-3 text-sm font-mono tracking-wider rounded transition-colors uppercase ${
                  isActive
                    ? "bg-zinc-800 text-white font-bold border border-zinc-700"
                    : "text-zinc-300 hover:text-white hover:bg-zinc-900"
                }`}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>

      {/* Dual Preview Panels inside Mobile Menu (Friendly Slate) */}
      <div class="grid sm:grid-cols-2 gap-3 mb-8">
        <div class="p-4 rounded-xl bg-[#131d33] border border-slate-800">
          <div class="flex items-center gap-2 text-xs font-mono text-sky-400 mb-1.5 uppercase tracking-wider">
            <Briefcase className="w-3.5 h-3.5" /> Profesional
          </div>
          <p class="text-xs text-slate-300 mb-3">
            Arquitectura backend en Spring Boot &amp; .NET y bases de datos relacionales.
          </p>
          <a href="/portfolio" class="mobile-nav-link text-xs font-mono text-white underline underline-offset-4 hover:text-sky-400">
            Ir a Portafolio →
          </a>
        </div>

        <div class="p-4 rounded-xl bg-[#131d33] border border-slate-800">
          <div class="flex items-center gap-2 text-xs font-mono text-sky-400 mb-1.5 uppercase tracking-wider">
            <GraduationCap className="w-3.5 h-3.5" /> Académico
          </div>
          <p class="text-xs text-slate-300 mb-3">
            Formación en la UPC y acreditaciones por Meta, Oracle Academy y Univ. of Michigan.
          </p>
          <a href="/certificates" class="mobile-nav-link text-xs font-mono text-white underline underline-offset-4 hover:text-sky-400">
            Ir a Certificaciones →
          </a>
        </div>
      </div>
    </div>

    <div class="pt-6 border-t border-zinc-800 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <a href="https://github.com/paulollito29-sketch" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-white">
          <Github className="w-4 h-4" />
        </a>
        <a href="https://www.linkedin.com/in/paulo-espinoza9/" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-cyan-400">
          <Linkedin className="w-4 h-4" />
        </a>
        <a href="mailto:paulespinoza951@gmail.com" class="text-zinc-400 hover:text-white">
          <Mail className="w-4 h-4" />
        </a>
      </div>
      <span class="text-[11px] font-mono text-zinc-500">© 2026 PAULO ESPINOZA</span>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("menuToggle");
  const closeBtn = document.getElementById("mobileMenuClose");
  const menu = document.getElementById("mobileMenu");
  const navLinks = document.querySelectorAll(".mobile-nav-link");

  function openMenu() {
    if (!menu) return;
    menu.classList.remove("opacity-0", "pointer-events-none");
    menu.classList.add("opacity-100", "pointer-events-auto");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    if (!menu) return;
    menu.classList.add("opacity-0", "pointer-events-none");
    menu.classList.remove("opacity-100", "pointer-events-auto");
    document.body.style.overflow = "";
  }

  toggleBtn?.addEventListener("click", () => {
    if (menu?.classList.contains("opacity-100")) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  closeBtn?.addEventListener("click", closeMenu);
  navLinks.forEach((link) => link.addEventListener("click", closeMenu));
</script>
