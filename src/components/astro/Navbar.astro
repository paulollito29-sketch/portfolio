---
import { Code2, Menu, X, Sparkles, Send } from "lucide-react";

const navLinks = [
  { label: "Inicio", href: "#hero" },
  { label: "Sobre mí", href: "#about" },
  { label: "Skills", href: "#skills" },
  { label: "Proyectos", href: "#projects" },
  { label: "Certificaciones", href: "#certificates" },
  { label: "Blog", href: "#blog" },
  { label: "Contacto", href: "#contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-40 px-4 sm:px-6 py-4">
  <div class="max-w-5xl mx-auto flex items-center justify-between px-5 py-3 rounded-2xl glass-card border border-white/10 shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
    <!-- Brand Logo -->
    <a href="#hero" class="flex items-center gap-2.5 text-white font-bold text-sm tracking-wide group">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-[0_0_15px_rgba(6,182,212,0.4)] group-hover:scale-105 transition-transform">
        <Code2 className="w-4 h-4" />
      </div>
      <span class="font-mono">Paulo<span class="text-cyan-400">.dev</span></span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3.5 py-1.5 rounded-lg text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/5 transition-all"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right CTA Button -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="#contact"
        class="px-3.5 py-1.5 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 text-xs font-mono flex items-center gap-1.5 transition-all shadow-[0_0_15px_rgba(6,182,212,0.15)]"
      >
        <Send className="w-3 h-3" />
        <span>Hablemos</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      class="md:hidden p-2 rounded-xl text-zinc-300 hover:text-white hover:bg-white/10 transition-colors"
      aria-label="Abrir menú de navegación"
    >
      <Menu className="w-5 h-5" />
    </button>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div
    id="mobile-menu-drawer"
    class="md:hidden fixed inset-x-4 top-20 rounded-2xl glass-card border border-white/15 p-6 shadow-2xl space-y-4 opacity-0 pointer-events-none transition-all duration-300 transform -translate-y-4 z-50 bg-[#0d111a]/95 backdrop-blur-xl"
  >
    <div class="flex items-center justify-between border-b border-white/10 pb-3">
      <span class="text-xs font-mono text-cyan-400 flex items-center gap-1.5">
        <Sparkles className="w-3.5 h-3.5" /> Navegación
      </span>
      <button id="mobile-menu-close" class="p-1 rounded-lg text-zinc-400 hover:text-white" aria-label="Cerrar menú">
        <X className="w-4 h-4" />
      </button>
    </div>

    <div class="flex flex-col gap-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-item py-2 px-3 rounded-xl text-sm font-medium text-zinc-300 hover:text-white hover:bg-white/5 transition-all"
        >
          {link.label}
        </a>
      ))}
    </div>

    <a
      href="#contact"
      class="mobile-nav-item w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 text-white text-xs font-semibold flex items-center justify-center gap-2 shadow-lg"
    >
      <Send className="w-3.5 h-3.5" /> Contactarme
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const closeBtn = document.getElementById("mobile-menu-close");
  const drawer = document.getElementById("mobile-menu-drawer");
  const navItems = document.querySelectorAll(".mobile-nav-item");

  function openMenu() {
    if (!drawer) return;
    drawer.classList.remove("opacity-0", "pointer-events-none", "-translate-y-4");
    drawer.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
  }

  function closeMenu() {
    if (!drawer) return;
    drawer.classList.add("opacity-0", "pointer-events-none", "-translate-y-4");
    drawer.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
  }

  toggleBtn?.addEventListener("click", () => {
    if (drawer?.classList.contains("opacity-100")) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  closeBtn?.addEventListener("click", closeMenu);
  navItems.forEach((item) => item.addEventListener("click", closeMenu));
</script>
