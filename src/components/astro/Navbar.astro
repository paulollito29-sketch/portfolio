---
import { Code2, Menu, X, FileText, Send, Briefcase } from "lucide-react";

const navLinks = [
  { label: "Perfil", href: "#hero" },
  { label: "Experiencia & Formación", href: "#about" },
  { label: "Competencias", href: "#skills" },
  { label: "Proyectos Empresariales", href: "#projects" },
  { label: "Certificaciones", href: "#certificates" },
  { label: "Contacto", href: "#contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-40 px-4 sm:px-6 py-3.5">
  <div class="max-w-6xl mx-auto flex items-center justify-between px-5 py-3 rounded-2xl glass-card border border-white/10 shadow-[0_12px_36px_rgba(0,0,0,0.6)]">
    <!-- Brand Logo -->
    <a href="#hero" class="flex items-center gap-3 text-white font-bold text-sm tracking-wide group">
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-b from-sky-400 via-blue-600 to-blue-700 flex items-center justify-center text-white shadow-[0_0_25px_rgba(14,165,233,0.45)] group-hover:scale-105 group-hover:shadow-[0_0_30px_rgba(56,189,248,0.7)] transition-all">
        <Code2 className="w-5 h-5 stroke-[2.5]" />
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-white tracking-tight leading-tight text-sm">Paulo Espinoza</span>
        <span class="text-[10px] font-mono text-sky-400 font-semibold tracking-tight">Ingeniero de Sistemas de Información</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-white/5 transition-all"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Recruiter CTAs -->
    <div class="hidden sm:flex items-center gap-2.5">
      <a
        href="#contact"
        class="px-3.5 py-2 rounded-xl bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 border border-sky-500/30 text-xs font-semibold flex items-center gap-1.5 transition-all shadow-[0_0_15px_rgba(14,165,233,0.15)]"
      >
        <Send className="w-3.5 h-3.5" />
        <span>Contratar / Contacto</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      class="lg:hidden p-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition-colors"
      aria-label="Abrir menú de navegación"
    >
      <Menu className="w-5 h-5" />
    </button>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div
    id="mobile-menu-drawer"
    class="lg:hidden fixed inset-x-4 top-20 rounded-2xl glass-card border border-white/15 p-6 shadow-2xl space-y-4 opacity-0 pointer-events-none transition-all duration-300 transform -translate-y-4 z-50 bg-[#0d121d]/95 backdrop-blur-2xl"
  >
    <div class="flex items-center justify-between border-b border-white/10 pb-3">
      <span class="text-xs font-mono text-sky-400 flex items-center gap-1.5">
        <Briefcase className="w-3.5 h-3.5" /> Menú de Selección &amp; Perfil
      </span>
      <button id="mobile-menu-close" class="p-1 rounded-lg text-slate-400 hover:text-white" aria-label="Cerrar menú">
        <X className="w-4 h-4" />
      </button>
    </div>

    <div class="flex flex-col gap-1.5">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-item py-2 px-3 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 transition-all"
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="pt-2 border-t border-white/10">
      <a
        href="#contact"
        class="mobile-nav-item w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-blue-600 to-sky-600 text-white text-xs font-semibold flex items-center justify-center gap-2 shadow-lg"
      >
        <Send className="w-3.5 h-3.5" /> Iniciar Contacto / Entrevista
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const closeBtn = document.getElementById("mobile-menu-close");
  const drawer = document.getElementById("mobile-menu-drawer");
  const navItems = document.querySelectorAll(".mobile-nav-item");

  function openMenu() {
    if (!drawer) return;
    drawer.classList.remove("opacity-0", "pointer-events-none", "-translate-y-4");
    drawer.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
  }

  function closeMenu() {
    if (!drawer) return;
    drawer.classList.add("opacity-0", "pointer-events-none", "-translate-y-4");
    drawer.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
  }

  toggleBtn?.addEventListener("click", () => {
    if (drawer?.classList.contains("opacity-100")) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  closeBtn?.addEventListener("click", closeMenu);
  navItems.forEach((item) => item.addEventListener("click", closeMenu));
</script>
