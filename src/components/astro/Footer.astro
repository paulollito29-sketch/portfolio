---
import { Heart, Github, Linkedin, Mail, Code2 } from "lucide-react";
const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-white/10 py-12 px-4 sm:px-6 bg-[#05070c]/80 backdrop-blur-md">
  <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Brand & Details -->
    <div class="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-lg bg-cyan-500/20 border border-cyan-500/30 flex items-center justify-center text-cyan-400">
          <Code2 className="w-3.5 h-3.5" />
        </div>
        <span class="font-mono text-xs font-bold text-white">Paulo Espinoza</span>
      </div>
      <span class="hidden sm:inline text-zinc-600">|</span>
      <p class="text-xs text-zinc-400 flex items-center gap-1">
        Construido con <Heart className="w-3 h-3 text-red-500 fill-red-500 inline" /> en Astro, React 19 &amp; Framer Motion
      </p>
    </div>

    <!-- Social Links & Year -->
    <div class="flex items-center gap-6">
      <div class="flex items-center gap-3">
        <a
          href="https://github.com/paulollito29-sketch"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg text-zinc-400 hover:text-white hover:bg-white/5 transition-colors"
          aria-label="GitHub"
        >
          <Github className="w-4 h-4" />
        </a>
        <a
          href="https://www.linkedin.com/in/paulo-espinoza9/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg text-zinc-400 hover:text-white hover:bg-white/5 transition-colors"
          aria-label="LinkedIn"
        >
          <Linkedin className="w-4 h-4" />
        </a>
        <a
          href="mailto:paulespinoza951@gmail.com"
          class="p-2 rounded-lg text-zinc-400 hover:text-white hover:bg-white/5 transition-colors"
          aria-label="Email"
        >
          <Mail className="w-4 h-4" />
        </a>
      </div>

      <span class="text-xs font-mono text-zinc-500">© {year}</span>
    </div>
  </div>
</footer>
