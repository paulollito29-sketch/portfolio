---
import Icon from "./icons/Icon.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { label: "Inicio", href: "/" },
  { label: "Perfil", href: "/profile" },
  { label: "Servicios", href: "/services" },
  { label: "Portafolio", href: "/portfolio" },
  { label: "Certificaciones", href: "/certificates" },
  { label: "CV", href: "/cv" },
  { label: "Contacto", href: "/contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#0a0b10] border-b border-[#1c2230] transition-[background-color] duration-150" id="mainHeader">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-8 py-3.5">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group cursor-pointer pressable">
      <span class="font-display font-bold text-base sm:text-lg tracking-tight text-white group-hover:text-sky-400 transition-colors">
        PAULO ESPINOZA
      </span>
      <span class="text-zinc-600 text-xs hidden sm:inline">|</span>
      <span class="text-xs text-zinc-400 hidden sm:inline font-medium">
        Ingeniero de Sistemas · UPC
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1">
      {navLinks.map((link) => {
        const isActive = (link.href === "/" && pathname === "/") || (link.href !== "/" && pathname.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 text-xs font-medium tracking-tight rounded-md transition-[background-color,color,transform] duration-150 active:scale-95 ${
              isActive
                ? "bg-zinc-800/90 text-white font-semibold"
                : "text-zinc-400 hover:text-zinc-100 hover:bg-zinc-900/60"
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Utilities / Social Icons -->
    <div class="hidden sm:flex items-center gap-3">
      <div class="flex items-center gap-1 pr-3 border-r border-[#1e2433]">
        <a
          href="https://github.com/paulollito29-sketch"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded text-zinc-400 hover:text-white hover:bg-zinc-800/60 transition-[color,transform] duration-150 active:scale-90"
          aria-label="GitHub de Paulo Espinoza"
          title="GitHub"
        >
          <Icon name="github" class="w-4 h-4" />
        </a>
        <a
          href="https://www.linkedin.com/in/paulo-espinoza9/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded text-zinc-400 hover:text-sky-400 hover:bg-zinc-800/60 transition-[color,transform] duration-150 active:scale-90"
          aria-label="LinkedIn de Paulo Espinoza"
          title="LinkedIn"
        >
          <Icon name="linkedin" class="w-4 h-4" />
        </a>
        <a
          href="https://wa.me/51906920958"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded text-zinc-400 hover:text-emerald-400 hover:bg-zinc-800/60 transition-[color,transform] duration-150 active:scale-90"
          aria-label="WhatsApp de Paulo Espinoza"
          title="WhatsApp"
        >
          <Icon name="phone" class="w-4 h-4" />
        </a>
        <a
          href="mailto:paulespinoza951@gmail.com"
          class="p-1.5 rounded text-zinc-400 hover:text-white hover:bg-zinc-800/60 transition-[color,transform] duration-150 active:scale-90"
          aria-label="Email de Paulo Espinoza"
          title="Email"
        >
          <Icon name="mail" class="w-4 h-4" />
        </a>
      </div>

      <a
        href="/contact"
        class={`px-3.5 py-1.5 rounded-md text-xs font-semibold tracking-tight transition-[background-color,color,transform] duration-150 active:scale-95 ${
          pathname === "/contact"
            ? "bg-white text-zinc-950"
            : "bg-zinc-900 hover:bg-zinc-800 text-zinc-200"
        }`}
      >
        Contacto
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button
      id="menuToggle"
      class="lg:hidden p-2 rounded text-zinc-300 hover:text-white hover:bg-zinc-800/60 transition-[transform] duration-150 active:scale-90 cursor-pointer"
      aria-label="Abrir menú de navegación"
    >
      <Icon name="menu" class="w-5 h-5" />
    </button>
  </div>

  <!-- Mobile Overlay Menu -->
  <div
    id="mobileMenu"
    class="lg:hidden fixed inset-0 top-[53px] bg-[#0a0b10] p-6 overflow-y-auto opacity-0 pointer-events-none transition-opacity duration-200 z-50 flex flex-col justify-between"
  >
    <div>
      <div class="flex items-center justify-between pb-3 border-b border-zinc-800 mb-5">
        <span class="text-xs text-zinc-400 font-medium flex items-center gap-2">
          <Icon name="shield-check" class="w-4 h-4 text-sky-400" /> Navegación
        </span>
        <button id="mobileMenuClose" class="p-1 text-zinc-400 hover:text-white cursor-pointer active:scale-90" aria-label="Cerrar">
          <Icon name="x" class="w-5 h-5" />
        </button>
      </div>

      <ul class="space-y-1.5 mb-6">
        {navLinks.map((link) => {
          const isActive = (link.href === "/" && pathname === "/") || (link.href !== "/" && pathname.startsWith(link.href));
          return (
            <li>
              <a
                href={link.href}
                class={`mobile-nav-link block py-2.5 px-3 text-sm font-medium rounded-md transition-[background-color,color] duration-150 ${
                  isActive
                    ? "bg-zinc-800 text-white font-semibold"
                    : "text-zinc-300 hover:text-white hover:bg-zinc-900"
                }`}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="pt-5 border-t border-zinc-800 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="https://github.com/paulollito29-sketch" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-white active:scale-90">
          <Icon name="github" class="w-4 h-4" />
        </a>
        <a href="https://www.linkedin.com/in/paulo-espinoza9/" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-sky-400 active:scale-90">
          <Icon name="linkedin" class="w-4 h-4" />
        </a>
        <a href="mailto:paulespinoza951@gmail.com" class="text-zinc-400 hover:text-white active:scale-90">
          <Icon name="mail" class="w-4 h-4" />
        </a>
      </div>
      <span class="text-xs text-zinc-500">© 2026 Paulo Espinoza</span>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    const toggleBtn = document.getElementById("menuToggle");
    const closeBtn = document.getElementById("mobileMenuClose");
    const menu = document.getElementById("mobileMenu");
    const navLinks = document.querySelectorAll(".mobile-nav-link");

    function openMenu() {
      if (!menu) return;
      menu.classList.remove("opacity-0", "pointer-events-none");
      menu.classList.add("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "hidden";
    }

    function closeMenu() {
      if (!menu) return;
      menu.classList.add("opacity-0", "pointer-events-none");
      menu.classList.remove("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "";
    }

    toggleBtn?.addEventListener("click", () => {
      if (menu?.classList.contains("opacity-100")) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeBtn?.addEventListener("click", closeMenu);
    navLinks.forEach((link) => link.addEventListener("click", closeMenu));
  }

  setupNavbar();
  document.addEventListener("astro:page-load", setupNavbar);
</script>
