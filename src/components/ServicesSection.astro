---
import { getCollection } from "astro:content";

const serviceEntries = await getCollection("services").catch(() => []);
const sortedServices = serviceEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const services = sortedServices.length > 0 ? sortedServices.map((s) => s.data) : [
  {
    tag: { es: "Metodología SDD" },
    name: { es: "Especificación y diseño de sistemas (SDD)" },
    description: { es: "Elaboración de Software Design Documents (SDD), especificación formal de requerimientos, contratos OpenAPI y arquitectura Clean/SOLID previa a la implementación." },
    points: {
      es: [
        "Diseño de Software Design Documents (SDD) y especificaciones técnicas",
        "Definición formal de contratos API RESTful con OpenAPI y Swagger",
        "Arquitectura desacoplada en capas y principios SOLID",
        "Modelado de dominio de negocio y casos de uso empresariales"
      ]
    }
  },
  {
    tag: { es: "Backend core" },
    name: { es: "Desarrollo de servicios y APIs" },
    description: { es: "Construcción de APIs RESTful de alto rendimiento en Java (Spring Boot) y C# (.NET Core) con seguridad JWT." },
    points: {
      es: [
        "Microservicios desacoplados con Spring Boot y .NET Core",
        "Autenticación segura basada en tokens JWT y roles",
        "Documentación interactiva con Swagger y OpenAPI 3.0",
        "Contenedorización con Docker y Docker Compose"
      ]
    }
  },
  {
    tag: { es: "Persistencia" },
    name: { es: "Modelado relacional y SQL" },
    description: { es: "Diseño de esquemas relacionales, transacciones ACID, optimización de consultas complejas y procedimientos almacenados." },
    points: {
      es: [
        "Modelado relacional en PostgreSQL, SQL Server y Oracle SQL",
        "Optimización de índices y planes de ejecución",
        "Mapeo eficiente con ORMs (JPA/Hibernate y EF Core)",
        "Integridad referencial y políticas transaccionales"
      ]
    }
  },
  {
    tag: { es: "Aceleración con IA" },
    name: { es: "Desarrollo asistido por IA y Full Stack" },
    description: { es: "Construcción acelerada de sistemas web y microservicios mediante flujos asistidos por IA (LLMs, Copilot, Cursor y testing guiado)." },
    points: {
      es: [
        "Ciclo de desarrollo acelerado con herramientas de IA generativa",
        "Interfaces reactivas con React, Next.js y Astro",
        "Generación y ejecución automatizada de tests unitarios",
        "Refactorización continua y aseguramiento de calidad de código"
      ]
    }
  }
];
---

<section id="services" class="py-12 px-4 sm:px-8 relative z-10">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="space-y-2">
      <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">
        Servicios de ingeniería de software
      </h2>
      <p class="text-base sm:text-lg text-zinc-300 max-w-2xl leading-relaxed">
        Capacidades técnicas estructuradas para el desarrollo integral de sistemas de información empresariales, desde la especificación hasta el despliegue.
      </p>
    </div>

    <!-- Services Grid (Editorial layout without icon squares) -->
    <div class="grid md:grid-cols-2 gap-6">
      {services.map((svc: any) => (
        <div class="bg-[#151515] rounded-lg p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="mb-3">
              <span class="text-xs px-2.5 py-1 rounded bg-[#202020] text-zinc-300 font-medium">
                {svc.tag.es}
              </span>
            </div>

            <h3 class="text-xl font-bold text-white mb-2">
              {svc.name.es}
            </h3>

            <p class="text-base text-zinc-300 leading-relaxed mb-5">
              {svc.description.es}
            </p>

            <ul class="space-y-2.5 mb-6">
              {svc.points.es.map((pt: string) => (
                <li class="flex items-start gap-2.5 text-sm sm:text-base text-zinc-300">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#b11226] mt-2 shrink-0"></span>
                  <span class="leading-relaxed">{pt}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-4 flex items-center justify-between">
            <a
              href="/contact"
              class="btn-primary text-xs"
            >
              Consultar servicio
            </a>
            <a
              href="/portfolio"
              class="text-xs text-zinc-400 hover:text-white transition-colors"
            >
              Ver proyectos relacionados &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
