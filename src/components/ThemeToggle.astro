---
import Icon from "./icons/Icon.astro";

interface Props {
  class?: string;
  id?: string;
}

const { class: className = "", id = "themeToggleBtn" } = Astro.props;
---

<button
  type="button"
  id={id}
  class={`theme-toggle-btn relative inline-flex items-center justify-center w-9 h-9 rounded-md bg-[var(--surface-lift)] text-[var(--ink-secondary)] hover:text-[var(--ink)] hover:bg-[var(--surface)] transition-[transform,background-color,color] duration-150 cursor-pointer active:scale-90 focus-visible:outline-2 focus-visible:outline-[var(--accent)] ${className}`}
  aria-label="Cambiar tema (claro / oscuro)"
  title="Alternar modo claro u oscuro"
>
  <!-- Sun Icon (shown in dark mode) -->
  <span class="theme-icon-sun transition-[transform,opacity] duration-200 transform scale-90 rotate-90 opacity-0 absolute">
    <Icon name="sun" class="w-4 h-4 text-amber-500 dark:text-amber-400" />
  </span>

  <!-- Moon Icon (shown in light mode) -->
  <span class="theme-icon-moon transition-[transform,opacity] duration-200 transform scale-100 rotate-0 opacity-100 absolute">
    <Icon name="moon" class="w-4 h-4 text-slate-700 dark:text-slate-300" />
  </span>
</button>

<style>
  :global(html.dark) .theme-icon-sun {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
  :global(html.dark) .theme-icon-moon {
    transform: scale(0.9) rotate(-90deg);
    opacity: 0;
  }
</style>

<script>
  function setupThemeToggles() {
    const buttons = document.querySelectorAll(".theme-toggle-btn");

    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (_) {}

      window.dispatchEvent(new CustomEvent("theme-changed", { detail: { theme: isDark ? "dark" : "light" } }));
    }

    buttons.forEach((btn) => {
      btn.removeEventListener("click", toggleTheme);
      btn.addEventListener("click", toggleTheme);
    });
  }

  setupThemeToggles();
  document.addEventListener("astro:page-load", setupThemeToggles);
</script>
