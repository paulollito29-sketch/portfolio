---
import { getCollection } from "astro:content";

const profileEntries = await getCollection("profile").catch(() => []);
const personalEntry = profileEntries.find((entry) => entry.id === "personal");
const capabilitiesEntry = profileEntries.find((entry) => entry.id === "capabilities");

const personal = personalEntry?.data?.personal;
const capabilitiesList = capabilitiesEntry?.data?.capabilities || [
  {
    title: { es: "Metodología SDD y especificación formal" },
    description: { es: "Diseño riguroso mediante Software Design Documents (SDD), definición de contratos OpenAPI y arquitectura limpia antes de codificar." },
    tags: { es: ["Metodología SDD", "OpenAPI", "Clean Architecture"] }
  },
  {
    title: { es: "Desarrollo asistido por Inteligencia Artificial" },
    description: { es: "Aceleración sistemática del ciclo de vida del software mediante flujos con IA (LLMs, Copilot, Cursor), generación de tests y refactorización continua." },
    tags: { es: ["Flujos IA", "Prompt Engineering", "Testing Automatizado"] }
  },
  {
    title: { es: "Backend core y persistencia relacional" },
    description: { es: "Microservicios desacoplados en Java (Spring Boot) con persistencia transaccional ACID en PostgreSQL y SQL Server, principios SOLID y seguridad JWT." },
    tags: { es: ["Spring Boot", "PostgreSQL", "SQL Server", "Seguridad JWT"] }
  }
];

const bioParagraphs = personal?.bioParagraphs?.es || [
  "Estudiante de 7º ciclo de Ingeniería de Sistemas de Información en la UPC con 8 meses de experiencia práctica en desarrollo Full Stack en el Servicio de Informática de la Fuerza Aérea.",
  "Especializado en backend con Java (Spring Boot, Spring Data JPA) y frontend moderno con React.js y Angular.ts, con experiencia en APIs RESTful seguras, optimización de consultas SQL y desarrollo asistido por IA.",
  "Enfoque riguroso en buenas prácticas de arquitectura, principios SOLID, código limpio y resolución ágil de problemas."
];
---

<section id="about" class="py-12 px-4 sm:px-8 relative z-10">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="space-y-2">
      <h2 class="text-2xl sm:text-4xl font-display font-bold text-[var(--ink)] tracking-tight">
        Perfil profesional y trayectoria
      </h2>
      <p class="text-sm sm:text-base text-[var(--ink-muted)] max-w-2xl leading-relaxed">
        Ingeniero de Sistemas de Información de la UPC con formación técnica orientada al diseño de software robusto, arquitecturas escalables y gestión de datos empresariales.
      </p>
    </div>

    <!-- Candidate Core Facts Section (Editorial narrative split) -->
    <div class="grid lg:grid-cols-12 gap-6 items-stretch">
      <div class="lg:col-span-5 bg-[var(--surface-card)] rounded-xl p-6 sm:p-8 flex flex-col justify-between space-y-4 transition-colors duration-200">
        <div>
          <span class="text-xs font-semibold text-[var(--ink-muted)] block mb-1">
            Datos clave del candidato
          </span>
          <h3 class="text-xl sm:text-2xl font-bold text-[var(--ink)] mb-2">
            Paulo Daniel Espinoza Gamboa
          </h3>
          <p class="text-sm text-[var(--ink-secondary)] leading-relaxed">
            Estudiante de 7º ciclo en la Universidad Peruana de Ciencias Aplicadas (UPC). Perteneciente al tercio superior académico.
          </p>
        </div>

        <div class="pt-4 space-y-3 text-sm text-[var(--ink-secondary)]">
          <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="font-medium text-[var(--ink)]">Disponibilidad inmediata (Open to Work)</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full bg-[var(--ink-faint)]"></span>
            <span>Modalidad remota o híbrida (Lima, Perú)</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full bg-[var(--accent)]"></span>
            <span>Experiencia: Servicio de Informática de la FAP (8 meses)</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 bg-[var(--surface-card)] rounded-xl p-6 sm:p-8 space-y-4 text-sm sm:text-base text-[var(--ink-secondary)] leading-relaxed transition-colors duration-200">
        {bioParagraphs.map((p: string) => (
          <p class="leading-relaxed">{p}</p>
        ))}
      </div>
    </div>

    <!-- Pillars Grid (Editorial layout with card-hover-lift) -->
    <div class="grid md:grid-cols-3 gap-6">
      {capabilitiesList.map((c: any) => (
        <div class="bg-[var(--surface-card)] rounded-xl p-6 sm:p-7 flex flex-col justify-between card-hover-lift transition-colors duration-200">
          <div>
            <h3 class="text-lg font-bold text-[var(--ink)] mb-2">
              {c.title.es}
            </h3>
            <p class="text-sm text-[var(--ink-secondary)] leading-relaxed mb-4">
              {c.description.es}
            </p>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-3">
            {c.tags.es.map((tag: string) => (
              <span class="text-xs px-2.5 py-0.5 rounded-md bg-[var(--surface-lift)] text-[var(--ink-secondary)] font-medium">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
