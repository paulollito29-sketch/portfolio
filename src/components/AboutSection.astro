---
import { getCollection } from "astro:content";
import Icon from "./icons/Icon.astro";

const profileEntries = await getCollection("profile").catch(() => []);
const personalEntry = profileEntries.find((entry) => entry.id === "personal");
const capabilitiesEntry = profileEntries.find((entry) => entry.id === "capabilities");

const personal = personalEntry?.data?.personal;
const capabilitiesList = capabilitiesEntry?.data?.capabilities || [
  {
    title: { es: "Metodología SDD & Especificación de Software" },
    description: { es: "Diseño riguroso mediante Software Design Documents (SDD), definición de contratos OpenAPI/Swagger, diagramas de arquitectura y modelado de sistemas antes de la fase de código." },
    icon: "file-text",
    tags: { es: ["Metodología SDD", "Software Design Docs", "OpenAPI", "Clean Architecture"] }
  },
  {
    title: { es: "Desarrollo Asistido por Inteligencia Artificial" },
    description: { es: "Aceleración sistemática del ciclo de vida del software mediante flujos con IA (LLMs, Copilot, Cursor), scaffolding automatizado, generación de tests y refactorización continua." },
    icon: "cpu",
    tags: { es: ["DevOps AI", "Prompt Engineering", "Testing con IA", "Alta Velocidad"] }
  },
  {
    title: { es: "Backend Core & Gestión Relacional" },
    description: { es: "Microservicios desacoplados en Java (Spring Boot) con persistencia transaccional ACID en PostgreSQL y SQL Server, principios SOLID y seguridad perimetral JWT." },
    icon: "database",
    tags: { es: ["Spring Boot", "PostgreSQL", "SQL Server", "Seguridad JWT"] }
  }
];

const bioParagraphs = personal?.bioParagraphs?.es || [
  "Como Ingeniero de Sistemas de Información de la UPC, combino una sólida formación en sistemas computacionales con capacidad demostrada para diseñar, desarrollar y desplegar sistemas de información listos para producción.",
  "Mi metodología de trabajo integra la metodología SDD (Spec-Driven Development) y el desarrollo asistido por Inteligencia Artificial, garantizando microservicios seguros y escalables en Java (Spring Boot) y bases de datos relacionales, complementado con interfaces modernas en Angular, React, Next.js y Astro.",
  "Busco incorporarme a equipos de tecnología de alto rendimiento donde pueda aportar valor inmediato, resolver problemas complejos de negocio y acelerar el cumplimiento de objetivos estratégicos."
];
---

<section id="about" class="py-12 px-4 sm:px-8 relative z-10">
  <div class="max-w-7xl mx-auto space-y-10">
    <div class="space-y-2">
      <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">
        Formación Académica &amp; Metodología de Ingeniería
      </h2>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-2xl">
        Bases rigurosas de ingeniería de sistemas de información orientadas al diseño de arquitecturas escalables, persistencia estructurada y entrega continua.
      </p>
    </div>

    <!-- Executive Profile Grid -->
    <div class="grid lg:grid-cols-12 gap-6">
      <div class="lg:col-span-5 bg-[#10121a] border border-[#1d2230] rounded-lg p-6 space-y-4">
        <span class="text-xs font-semibold text-sky-400 block">
          Formación Universitaria
        </span>
        <h3 class="text-lg font-bold text-white leading-tight">
          Ingeniería de Sistemas de Información
        </h3>
        <p class="text-xs text-zinc-400">
          Universidad Peruana de Ciencias Aplicadas (UPC)
        </p>

        <div class="pt-4 border-t border-[#1a1f2c] space-y-2.5 text-xs text-zinc-300">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Disponibilidad inmediata para contratación (Open to Work)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
            <span>Modalidad Remota o Híbrida (Lima, Perú)</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 bg-[#10121a] border border-[#1d2230] rounded-lg p-6 space-y-3.5 text-xs sm:text-sm text-zinc-300 leading-relaxed">
        {bioParagraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>

    <!-- Pillars Grid -->
    <div class="grid md:grid-cols-3 gap-5">
      {capabilitiesList.map((c) => (
        <div class="bg-[#10121a] border border-[#1d2230] rounded-lg p-5 flex flex-col justify-between hover:border-[#2b3347] transition-[border-color] duration-150">
          <div>
            <div class="w-8 h-8 rounded-md bg-[#181b24] flex items-center justify-center text-sky-400 mb-3.5">
              <Icon name={c.icon} class="w-4 h-4" />
            </div>
            <h3 class="text-sm font-bold text-white mb-2">{c.title.es}</h3>
            <p class="text-xs text-zinc-400 leading-relaxed mb-4">{c.description.es}</p>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-3 border-t border-[#181d29]">
            {c.tags.es.map((tag: string) => (
              <span class="px-2 py-0.5 text-[11px] rounded bg-[#161922] text-zinc-300">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
