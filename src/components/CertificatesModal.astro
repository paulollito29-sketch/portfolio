---
import { getCollection } from "astro:content";
import Icon from "./icons/Icon.astro";

const certEntries = await getCollection("certificates").catch(() => []);
const sortedCerts = certEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const certificates = sortedCerts.map((c) => ({
  file: c.data.file,
  encodedFile: encodeURIComponent(c.data.file),
  title: c.data.title.es,
  issuer: c.data.issuer,
  institution: c.data.institution,
  icon: c.data.icon,
  category: c.data.category.es,
  skillsValidated: c.data.skillsValidated.es,
}));
---

<section id="certificates" class="max-w-7xl mx-auto px-4 sm:px-8 py-12 relative z-10 space-y-10">
  <div class="space-y-2">
    <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">
      Certificaciones <span class="gradient-text-sky">Oficiales Verificables</span>
    </h2>
    <p class="text-xs sm:text-sm text-zinc-300 max-w-2xl leading-relaxed">
      Credenciales académicas verificables otorgadas por Meta, Oracle Academy y University of Michigan (10 certificados PDF disponibles).
    </p>
  </div>

  <!-- Certificates Grid with Glassmorphic Cards -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {certificates.map((cert) => (
      <div
        class="cert-card glass-card p-6 flex flex-col justify-between cursor-pointer group active:scale-[0.99]"
        data-file={cert.encodedFile}
        data-raw-file={cert.file}
        data-title={cert.title}
        data-issuer={cert.issuer}
      >
        <div>
          <div class="flex items-center justify-between mb-3.5">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-sky-500/20 via-indigo-500/20 to-purple-500/15 flex items-center justify-center text-sky-400 border border-white/10 shadow-sm shadow-sky-500/10">
              <Icon name="award" class="w-4 h-4" />
            </div>
            <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-white/[0.04] border border-white/10 text-zinc-200">
              {cert.institution}
            </span>
          </div>

          <h3 class="text-sm sm:text-base font-bold text-white group-hover:text-sky-300 transition-colors duration-150 line-clamp-2 mb-1.5 leading-snug">
            {cert.title}
          </h3>
          <p class="text-xs text-sky-400/80 mb-3.5 font-medium">{cert.issuer}</p>

          <div class="space-y-1.5 mb-5">
            {cert.skillsValidated.slice(0, 3).map((skill: string) => (
              <div class="flex items-center gap-2 text-xs text-zinc-300 leading-relaxed">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-400 shrink-0 shadow-sm shadow-sky-400"></span>
                <span>{skill}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="pt-3.5 border-t border-white/[0.08] flex items-center justify-between">
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-300 group-hover:text-white transition-colors duration-150">
            <Icon name="eye" class="w-3.5 h-3.5 text-sky-400" /> Ver Documento PDF
          </span>

          <a
            href={`/certificates/${cert.encodedFile}`}
            target="_blank"
            rel="noopener noreferrer"
            download={cert.file}
            class="cert-download-link p-2 rounded-lg bg-white/[0.06] hover:bg-white/[0.12] text-zinc-300 hover:text-white transition-colors duration-150 active:scale-90 border border-white/10"
            aria-label={`Descargar PDF de ${cert.title}`}
            title="Descargar PDF"
          >
            <Icon name="download" class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- PDF Preview Modal with Frosted Glassmorphism Backdrop -->
  <div
    id="certModal"
    class="fixed inset-0 z-50 bg-[#06070a]/80 backdrop-blur-xl flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-label="Visor de Certificado Oficial"
  >
    <div class="glass-card w-full max-w-5xl h-[88vh] flex flex-col overflow-hidden shadow-2xl shadow-sky-500/10 border border-white/15">
      <!-- Modal Header -->
      <div class="flex items-center justify-between px-5 sm:px-7 py-4 border-b border-white/10 bg-white/[0.02]">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-sky-500/25 to-indigo-500/25 flex items-center justify-center text-sky-400 border border-white/10">
            <Icon name="award" class="w-4 h-4" />
          </div>
          <div>
            <h3 id="modalTitle" class="text-sm sm:text-base font-bold text-white line-clamp-1">
              Certificado Oficial
            </h3>
            <p id="modalIssuer" class="text-xs text-sky-400/80 font-medium"></p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a
            id="modalDownload"
            href="#"
            download
            target="_blank"
            class="btn-glass-outline text-xs !py-1.5 !px-3"
          >
            <Icon name="download" class="w-3.5 h-3.5" />
            <span class="hidden sm:inline">Descargar PDF</span>
          </a>

          <button
            id="modalClose"
            class="p-2 rounded-lg text-zinc-400 hover:text-white hover:bg-white/10 transition-colors duration-150 cursor-pointer"
            aria-label="Cerrar visor"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- PDF Frame -->
      <div class="flex-1 bg-[#0b0d14] relative">
        <iframe
          id="certFrame"
          src=""
          class="w-full h-full border-none"
          title="Vista previa del Certificado Oficial"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  function setupCertificatesModal() {
    const cards = document.querySelectorAll<HTMLElement>(".cert-card");
    const modal = document.getElementById("certModal");
    const modalClose = document.getElementById("modalClose");
    const modalTitle = document.getElementById("modalTitle");
    const modalIssuer = document.getElementById("modalIssuer");
    const modalDownload = document.getElementById("modalDownload") as HTMLAnchorElement | null;
    const certFrame = document.getElementById("certFrame") as HTMLIFrameElement | null;

    if (!modal || !modalClose || !certFrame) return;

    function openModal(file: string, rawFile: string, title: string, issuer: string) {
      if (!modal || !certFrame) return;
      if (modalTitle) modalTitle.textContent = title;
      if (modalIssuer) modalIssuer.textContent = issuer;
      if (modalDownload) {
        modalDownload.href = `/certificates/${file}`;
        modalDownload.download = rawFile;
      }
      certFrame.src = `/certificates/${file}#toolbar=0&navpanes=0`;

      modal.classList.remove("opacity-0", "pointer-events-none");
      modal.classList.add("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      if (!modal || !certFrame) return;
      modal.classList.add("opacity-0", "pointer-events-none");
      modal.classList.remove("opacity-100", "pointer-events-auto");
      certFrame.src = "";
      document.body.style.overflow = "";
    }

    cards.forEach((card) => {
      card.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest(".cert-download-link")) return;

        const file = card.getAttribute("data-file") || "";
        const rawFile = card.getAttribute("data-raw-file") || "";
        const title = card.getAttribute("data-title") || "";
        const issuer = card.getAttribute("data-issuer") || "";
        openModal(file, rawFile, title, issuer);
      });
    });

    modalClose.addEventListener("click", closeModal);

    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("opacity-0")) {
        closeModal();
      }
    });
  }

  setupCertificatesModal();
  document.addEventListener("astro:page-load", setupCertificatesModal);
</script>
