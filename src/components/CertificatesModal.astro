---
import { getCollection } from "astro:content";
import Icon from "./icons/Icon.astro";

const certEntries = await getCollection("certificates").catch(() => []);
const sortedCerts = certEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const certificates = sortedCerts.map((c) => ({
  file: c.data.file,
  encodedFile: encodeURIComponent(c.data.file),
  title: c.data.title.es,
  issuer: c.data.issuer,
  institution: c.data.institution,
  icon: c.data.icon,
  category: c.data.category.es,
  skillsValidated: c.data.skillsValidated.es,
}));
---

<section id="certificates" class="max-w-7xl mx-auto px-4 sm:px-8 py-12 relative z-10 space-y-10">
  <div class="space-y-2">
    <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">
      Certificaciones Oficiales
    </h2>
    <p class="text-xs sm:text-sm text-zinc-400 max-w-2xl">
      Credenciales académicas verificables otorgadas por Meta, Oracle Academy y University of Michigan.
    </p>
  </div>

  <!-- Certificates Grid -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {certificates.map((cert) => (
      <div
        class="cert-card bg-[#10121a] border border-[#1d2230] rounded-lg p-5 flex flex-col justify-between hover:border-[#2b3347] transition-[border-color] duration-150 cursor-pointer group active:scale-[0.99]"
        data-file={cert.encodedFile}
        data-raw-file={cert.file}
        data-title={cert.title}
        data-issuer={cert.issuer}
      >
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-lg p-1.5 rounded-md bg-[#161922] text-white">
              {cert.icon}
            </span>
            <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-[#161922] text-zinc-300">
              {cert.institution}
            </span>
          </div>

          <h3 class="text-sm sm:text-base font-bold text-white group-hover:text-sky-400 transition-colors duration-150 line-clamp-2 mb-1">
            {cert.title}
          </h3>
          <p class="text-xs text-zinc-400 mb-3">{cert.issuer}</p>

          <div class="space-y-1.5 mb-4">
            {cert.skillsValidated.slice(0, 3).map((skill) => (
              <div class="flex items-center gap-2 text-xs text-zinc-300">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-400 shrink-0"></span>
                <span>{skill}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="pt-3 border-t border-[#181d29] flex items-center justify-between">
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-400 group-hover:text-white transition-colors duration-150">
            <Icon name="eye" class="w-3.5 h-3.5" /> Ver Documento PDF
          </span>

          <a
            href={`/certificates/${cert.encodedFile}`}
            target="_blank"
            rel="noopener noreferrer"
            download={cert.file}
            class="cert-download-link p-1.5 rounded bg-[#161922] hover:bg-[#202533] text-zinc-400 hover:text-white transition-colors duration-150 active:scale-90"
            aria-label={`Descargar PDF de ${cert.title}`}
            title="Descargar PDF"
          >
            <Icon name="download" class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Native HTML5 Dialog Modal PDF Viewer -->
  <dialog
    id="certModalDialog"
    class="fixed inset-0 m-auto p-0 bg-transparent backdrop:bg-black/85 max-w-4xl w-[95vw] h-[85vh] border-0 outline-none z-50 rounded-lg overflow-hidden"
  >
    <div class="w-full h-full bg-[#10121a] border border-[#23293a] rounded-lg overflow-hidden flex flex-col">
      <!-- Modal Header -->
      <div class="flex items-center justify-between px-5 py-3.5 bg-[#0a0b10] border-b border-[#181d29] shrink-0">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-md bg-[#161922] flex items-center justify-center text-sky-400">
            <Icon name="file-text" class="w-4 h-4" />
          </div>
          <div>
            <h3 id="certModalTitle" class="text-sm font-bold text-white">Certificado</h3>
            <p id="certModalIssuer" class="text-xs text-zinc-400">Emisor Oficial</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a
            id="certModalOpenBtn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-950 bg-white hover:bg-sky-400 px-3 py-1.5 rounded-md transition-[background-color,transform] duration-150 active:scale-95"
          >
            <Icon name="external-link" class="w-3.5 h-3.5" />
            <span>Abrir</span>
          </a>

          <button
            id="certModalCloseBtn"
            type="button"
            class="p-1.5 rounded text-zinc-400 hover:text-white hover:bg-[#181d29] transition-colors duration-150 cursor-pointer active:scale-90"
            aria-label="Cerrar modal"
          >
            <Icon name="x" class="w-4 h-4" />
          </button>
        </div>
      </div>

      <!-- PDF Viewer Frame -->
      <div class="flex-1 w-full bg-[#08090c] relative">
        <iframe
          id="certModalIframe"
          src="about:blank"
          class="w-full h-full border-0"
          title="Vista previa del certificado"
        ></iframe>
      </div>
    </div>
  </dialog>
</section>

<script>
  function initCertificatesModal() {
    const dialog = document.getElementById("certModalDialog") as HTMLDialogElement | null;
    const iframe = document.getElementById("certModalIframe") as HTMLIFrameElement | null;
    const titleEl = document.getElementById("certModalTitle");
    const issuerEl = document.getElementById("certModalIssuer");
    const openBtn = document.getElementById("certModalOpenBtn") as HTMLAnchorElement | null;
    const closeBtn = document.getElementById("certModalCloseBtn");
    const certCards = document.querySelectorAll<HTMLElement>(".cert-card");
    const downloadLinks = document.querySelectorAll<HTMLElement>(".cert-download-link");

    if (!dialog || !iframe) return;

    downloadLinks.forEach((dl) => {
      dl.addEventListener("click", (e) => e.stopPropagation());
    });

    certCards.forEach((card) => {
      card.addEventListener("click", () => {
        const file = card.getAttribute("data-file") || "";
        const title = card.getAttribute("data-title") || "";
        const issuer = card.getAttribute("data-issuer") || "";

        if (titleEl) titleEl.textContent = title;
        if (issuerEl) issuerEl.textContent = issuer;
        if (openBtn) openBtn.href = `/certificates/${file}`;

        iframe.src = `/certificates/${file}#toolbar=0`;
        dialog.showModal();
        document.body.style.overflow = "hidden";
      });
    });

    const closeModal = () => {
      iframe.src = "about:blank";
      dialog.close();
      document.body.style.overflow = "";
    };

    closeBtn?.addEventListener("click", closeModal);

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) {
        closeModal();
      }
    });

    dialog.addEventListener("cancel", () => {
      iframe.src = "about:blank";
      document.body.style.overflow = "";
    });
  }

  initCertificatesModal();
  document.addEventListener("astro:page-load", initCertificatesModal);
</script>
