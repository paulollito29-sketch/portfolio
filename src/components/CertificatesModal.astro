---
import { getCollection } from "astro:content";
import Icon from "./icons/Icon.astro";

const certEntries = await getCollection("certificates").catch(() => []);
const sortedCerts = certEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const certificates = sortedCerts.map((c) => ({
  file: c.data.file,
  encodedFile: encodeURIComponent(c.data.file),
  title: c.data.title.es,
  issuer: c.data.issuer,
  institution: c.data.institution,
  icon: c.data.icon,
  category: c.data.category.es,
  skillsValidated: c.data.skillsValidated.es,
}));
---

<section id="certificates" class="max-w-7xl mx-auto px-4 sm:px-8 py-12 relative z-10 space-y-10">
  <div class="space-y-2">
    <h2 class="text-2xl sm:text-4xl font-display font-bold text-[var(--ink)] tracking-tight">
      Certificaciones oficiales verificables
    </h2>
    <p class="text-sm sm:text-base text-[var(--ink-muted)] max-w-2xl leading-relaxed">
      Credenciales académicas verificables otorgadas por Meta, Oracle Academy y University of Michigan (10 certificados PDF disponibles).
    </p>
  </div>

  <!-- Certificates Registry (Editorial list layout) -->
  <div class="bg-[var(--surface-card)] rounded-xl p-6 sm:p-8 space-y-3.5 transition-colors duration-200">
    {certificates.map((cert) => (
      <div
        class="cert-card p-5 rounded-lg bg-[var(--surface-lift)] hover:bg-[var(--surface)] transition-[transform,background-color] duration-150 flex flex-col md:flex-row md:items-center justify-between gap-4 cursor-pointer group card-hover-lift active:scale-[0.99]"
        data-file={cert.encodedFile}
        data-raw-file={cert.file}
        data-title={cert.title}
        data-issuer={cert.issuer}
      >
        <div class="flex-1 space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-md bg-[var(--bg)] text-[var(--ink-secondary)]">
              {cert.institution}
            </span>
            <span class="text-xs text-[var(--ink-muted)] font-medium">· {cert.issuer}</span>
          </div>

          <h3 class="text-lg font-bold text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors leading-snug">
            {cert.title}
          </h3>

          <p class="text-base text-[var(--ink-secondary)] leading-relaxed">
            {cert.skillsValidated.join(" · ")}
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 pt-2 md:pt-0">
          <span class="btn-primary !text-xs !py-1.5 !px-3.5">
            Ver PDF &rarr;
          </span>

          <a
            href={`/certificates/${cert.encodedFile}`}
            target="_blank"
            rel="noopener noreferrer"
            download={cert.file}
            class="cert-download-link btn-secondary !text-xs !py-1.5 !px-3.5"
            aria-label={`Descargar PDF de ${cert.title}`}
            title="Descargar PDF"
          >
            Descargar
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- PDF Preview Modal -->
  <div
    id="certModal"
    class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4 transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-label="Visor de Certificado Oficial"
  >
    <div class="bg-[var(--surface-card)] rounded-xl w-full max-w-5xl h-[88vh] flex flex-col overflow-hidden">
      <!-- Modal Header -->
      <div class="flex items-center justify-between px-5 sm:px-7 py-4 bg-[var(--surface-lift)]">
        <div>
          <h3 id="modalTitle" class="text-base font-bold text-[var(--ink)] line-clamp-1">
            Certificado oficial
          </h3>
          <p id="modalIssuer" class="text-xs text-[var(--ink-muted)] font-medium"></p>
        </div>

        <div class="flex items-center gap-2">
          <a
            id="modalDownload"
            href="#"
            download
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary text-xs !py-1.5 !px-3"
          >
            <Icon name="download" class="w-3.5 h-3.5" />
            <span class="hidden sm:inline">Descargar PDF</span>
          </a>

          <button
            id="modalClose"
            class="p-2 rounded-md text-[var(--ink-muted)] hover:text-[var(--ink)] hover:bg-[var(--border-subtle)] transition-colors cursor-pointer"
            aria-label="Cerrar visor"
          >
            <Icon name="x" class="w-4 h-4" />
          </button>
        </div>
      </div>

      <!-- PDF Frame -->
      <div class="flex-1 bg-[var(--bg)] relative">
        <iframe
          id="certFrame"
          src="about:blank"
          class="w-full h-full border-0"
          title="Vista previa de certificado PDF"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  function initCertModal() {
    const modal = document.getElementById("certModal");
    const certFrame = document.getElementById("certFrame") as HTMLIFrameElement | null;
    const modalTitle = document.getElementById("modalTitle");
    const modalIssuer = document.getElementById("modalIssuer");
    const modalDownload = document.getElementById("modalDownload") as HTMLAnchorElement | null;
    const modalClose = document.getElementById("modalClose");
    const certCards = document.querySelectorAll(".cert-card");

    function openModal(file: string, rawFile: string, title: string, issuer: string) {
      if (!modal || !certFrame) return;
      const pdfUrl = `/certificates/${file}`;
      certFrame.src = pdfUrl;

      if (modalTitle) modalTitle.textContent = title;
      if (modalIssuer) modalIssuer.textContent = issuer;
      if (modalDownload) {
        modalDownload.href = pdfUrl;
        modalDownload.download = rawFile;
      }

      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      if (!modal || !certFrame) return;
      modal.classList.add("hidden");
      certFrame.src = "about:blank";
      document.body.style.overflow = "";
    }

    certCards.forEach((card) => {
      card.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest(".cert-download-link")) return;

        const file = card.getAttribute("data-file") || "";
        const rawFile = card.getAttribute("data-raw-file") || "";
        const title = card.getAttribute("data-title") || "";
        const issuer = card.getAttribute("data-issuer") || "";
        openModal(file, rawFile, title, issuer);
      });
    });

    modalClose?.addEventListener("click", closeModal);

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });
  }

  initCertModal();
  document.addEventListener("astro:page-load", initCertModal);
</script>
