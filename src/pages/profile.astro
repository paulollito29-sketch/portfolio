---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import BackgroundScroll from "../components/BackgroundScroll.astro";
import OfficialUpdatePanel from "../components/OfficialUpdatePanel.astro";
import AboutSection from "../components/AboutSection.astro";
import SkillsMatrix from "../components/SkillsMatrix.astro";
import TestimonialsTrack from "../components/TestimonialsTrack.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
---

<Layout
  title="Perfil Oficial | Paulo Espinoza · Ingeniero de Sistemas de Información (UPC)"
  description="Perfil profesional, trayectoria académica en la UPC, pilares de ingeniería de sistemas y matriz de habilidades técnicas de Paulo Espinoza."
>
  <ScrollProgress />
  <BackgroundScroll />
  <Navbar />

  <main class="relative z-10 pt-20 pb-16 space-y-10">
    <!-- Page Header Banner -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-8 space-y-3">
      <h1 class="text-3xl sm:text-5xl font-display font-bold text-white tracking-tight">
        Ingeniero de Sistemas de Información
      </h1>
      <p class="text-sm sm:text-base text-zinc-300 max-w-3xl leading-relaxed">
        Formación universitaria en la <strong class="text-white">Universidad Peruana de Ciencias Aplicadas (UPC)</strong>, orientada al diseño de sistemas backend escalables, persistencia transaccional y microservicios de alto desempeño.
      </p>
    </div>

    <!-- Official Live Facts -->
    <OfficialUpdatePanel />

    <!-- Executive About & Core Capabilities -->
    <AboutSection />

    <!-- Technical Skills Matrix -->
    <SkillsMatrix />

    <!-- Testimonials Track -->
    <TestimonialsTrack />

    <!-- Direct CTA -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-4">
      <div class="p-6 sm:p-7 rounded bg-[#151515] flex flex-col sm:flex-row items-center justify-between gap-5">
        <div>
          <h2 class="text-lg font-bold text-white mb-1">
            ¿Interesado en coordinar una entrevista técnica?
          </h2>
          <p class="text-xs text-zinc-400">
            Disponible para incorporación inmediata en roles de Ingeniería de Sistemas, Backend en Java / .NET o Desarrollo Full Stack.
          </p>
        </div>
        <a
          href="/contact"
          class="btn-primary shrink-0 text-xs"
        >
          Contactar ahora &rarr;
        </a>
      </div>
    </div>
  </main>

  <Footer />
  <ScrollToTop />
</Layout>
