---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import ScrollProgress from "../components/react/ScrollProgress";
import BackgroundScroll from "../components/react/BackgroundScroll";
import OfficialUpdatePanel from "../components/react/OfficialUpdatePanel";
import AboutSection from "../components/react/AboutSection";
import SkillsMatrix from "../components/react/SkillsMatrix";
import TestimonialsTrack from "../components/react/TestimonialsTrack";
import ScrollToTop from "../components/react/ScrollToTop";
---

<Layout
  title="Perfil Oficial | Paulo Espinoza · Ingeniero de Sistemas de Información (UPC)"
  description="Perfil profesional, trayectoria académica en la UPC, pilares de ingeniería de sistemas y matriz de habilidades técnicas de Paulo Espinoza."
>
  <ScrollProgress client:load />
  <BackgroundScroll client:load />
  <Navbar />

  <main class="relative z-10 pt-20 pb-16 space-y-8">
    <!-- Page Header Banner -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-6">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-xs font-mono text-cyan-400 uppercase tracking-widest mb-3">
        <span>PERFIL PROFESIONAL &amp; TRAYECTORIA</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-display font-bold text-white uppercase tracking-tight">
        Ingeniero de Sistemas de Información
      </h1>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-3xl mt-2 leading-relaxed">
        Formación universitaria en la <strong class="text-white">Universidad Peruana de Ciencias Aplicadas (UPC)</strong>, orientada al diseño de sistemas backend escalables, persistencia de datos relacional y arquitecturas de microservicios.
      </p>
    </div>

    <!-- Official Live Facts -->
    <OfficialUpdatePanel client:load />

    <!-- Executive About & Core Capabilities -->
    <AboutSection client:load />

    <!-- Technical Skills Matrix -->
    <SkillsMatrix client:load />

    <!-- Testimonials Track -->
    <TestimonialsTrack client:load />

    <!-- Direct CTA (Flat) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-6">
      <div class="p-6 rounded-lg bg-[#121215] border border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-lg font-bold text-white uppercase mb-1">
            ¿Interesado en coordinar una entrevista técnica?
          </h3>
          <p class="text-xs text-zinc-400">
            Disponible para incorporación inmediata en roles de Sistemas, Backend en Java / .NET o Desarrollo Full Stack.
          </p>
        </div>
        <a
          href="/contact"
          class="px-5 py-2.5 rounded bg-white hover:bg-cyan-400 text-black font-semibold text-xs uppercase tracking-wider transition-colors shrink-0"
        >
          Contactar Ahora →
        </a>
      </div>
    </div>
  </main>

  <Footer />
  <ScrollToTop client:load />
</Layout>
