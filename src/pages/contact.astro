---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import ScrollProgress from "../components/react/ScrollProgress";
import BackgroundScroll from "../components/react/BackgroundScroll";
import ContactInteractive from "../components/react/ContactInteractive";
import ScrollToTop from "../components/react/ScrollToTop";
---

<Layout
  title="Contacto & Contratación | Paulo Espinoza · Ingeniero de Sistemas"
  description="Canal oficial de contacto y reclutamiento para Paulo Espinoza. Disponibilidad inmediata para roles en Ingeniería de Sistemas, Backend y Full Stack."
>
  <ScrollProgress client:load />
  <BackgroundScroll client:load />
  <Navbar />

  <main class="relative z-10 pt-20 pb-16 space-y-8">
    <!-- Page Header Banner -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-6">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-xs font-mono text-cyan-400 uppercase tracking-widest mb-3">
        <span>CANAL OFICIAL DE COMUNICACIÓN</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-display font-bold text-white uppercase tracking-tight">
        Contacto &amp; Contratación
      </h1>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-3xl mt-2 leading-relaxed">
        Comunícate directamente para coordinar entrevistas técnicas, evaluar propuestas laborales o consultar disponibilidad de desarrollo backend.
      </p>
    </div>

    <!-- Contact Interactive Form -->
    <ContactInteractive client:load />
  </main>

  <Footer />
  <ScrollToTop client:load />
</Layout>
