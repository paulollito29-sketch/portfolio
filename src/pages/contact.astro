---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import BackgroundScroll from "../components/BackgroundScroll.astro";
import ContactInteractive from "../components/ContactInteractive.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
---

<Layout
  title="Contacto & Contratación | Paulo Espinoza · Ingeniero de Sistemas"
  description="Canal oficial de contacto y reclutamiento para Paulo Espinoza. Disponibilidad inmediata para roles en Ingeniería de Sistemas, Backend y Full Stack."
>
  <ScrollProgress />
  <BackgroundScroll />
  <Navbar />

  <main class="relative z-10 pt-20 pb-16 space-y-10">
    <!-- Page Header Banner -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-8 space-y-3">
      <h1 class="text-3xl sm:text-5xl font-display font-bold text-white tracking-tight">
        Contacto Directo &amp; Contratación
      </h1>
      <p class="text-sm sm:text-base text-zinc-300 max-w-3xl leading-relaxed">
        Comunícate directamente para coordinar entrevistas técnicas, evaluar propuestas de contratación o consultar disponibilidad de consultoría.
      </p>
    </div>

    <!-- Contact Interactive Form -->
    <ContactInteractive />
  </main>

  <Footer />
  <ScrollToTop />
</Layout>
