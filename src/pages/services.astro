---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import BackgroundScroll from "../components/BackgroundScroll.astro";
import ServicesSection from "../components/ServicesSection.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
---

<Layout
  title="Servicios Especializados | Paulo Espinoza · Soluciones de Sistemas"
  description="Servicios profesionales de ingeniería de sistemas de información: auditoría y arquitectura de sistemas, desarrollo backend en Spring Boot y .NET, modelado de bases de datos y soluciones web con IA."
>
  <ScrollProgress />
  <BackgroundScroll />
  <Navbar />

  <main class="relative z-10 pt-20 pb-16 space-y-12">
    <!-- Page Header Banner -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-8 space-y-3">
      <h1 class="text-3xl sm:text-5xl font-display font-bold text-white tracking-tight">
        Servicios de Ingeniería de Sistemas
      </h1>
      <p class="text-sm sm:text-base text-zinc-300 max-w-3xl leading-relaxed">
        Soluciones estructuradas para organizaciones que demandan servicios backend confiables, persistencia relacional con garantías ACID y arquitecturas desacopladas.
      </p>
    </div>

    <!-- Services Section -->
    <ServicesSection />

    <!-- Methodology & Quality Process -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-8 space-y-8">
      <div class="space-y-2">
        <h2 class="text-xl sm:text-3xl font-display font-bold text-white tracking-tight">
          Metodología de Desarrollo &amp; Aseguramiento de Calidad
        </h2>
        <p class="text-xs sm:text-sm text-zinc-400 max-w-2xl">
          Flujo de ingeniería guiado por especificaciones formales (SDD) y aceleración asistida por IA.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-5 rounded-lg bg-[#10121a] border border-[#1d2230] space-y-2 hover:border-[#2b3347] transition-[border-color] duration-150">
          <span class="text-xs text-sky-400 font-semibold">Análisis &amp; Especificación</span>
          <h3 class="text-sm font-bold text-white">Modelado de Requerimientos</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Modelado del dominio del negocio, diagramas de arquitectura de sistemas y contratos de API mediante especificación OpenAPI.
          </p>
        </div>

        <div class="p-5 rounded-lg bg-[#10121a] border border-[#1d2230] space-y-2 hover:border-[#2b3347] transition-[border-color] duration-150">
          <span class="text-xs text-sky-400 font-semibold">Diseño Estructural</span>
          <h3 class="text-sm font-bold text-white">Arquitectura &amp; Persistencia</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Diseño del esquema relacional en SQL Server / Oracle con restricciones de integridad ACID y separación en capas de servicio.
          </p>
        </div>

        <div class="p-5 rounded-lg bg-[#10121a] border border-[#1d2230] space-y-2 hover:border-[#2b3347] transition-[border-color] duration-150">
          <span class="text-xs text-sky-400 font-semibold">Implementación Core</span>
          <h3 class="text-sm font-bold text-white">Construcción &amp; Seguridad</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Desarrollo en Spring Boot / .NET Core con seguridad JWT, validación de inputs y manejo centralizado de excepciones.
          </p>
        </div>

        <div class="p-5 rounded-lg bg-[#10121a] border border-[#1d2230] space-y-2 hover:border-[#2b3347] transition-[border-color] duration-150">
          <span class="text-xs text-sky-400 font-semibold">Entrega Continua</span>
          <h3 class="text-sm font-bold text-white">Pruebas &amp; Contenedores</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Tests automatizados de integración, empaquetado en imágenes Docker y configuración de despliegue reproducible.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
  <ScrollToTop />
</Layout>
