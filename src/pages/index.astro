---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import ScrollProgress from "../components/react/ScrollProgress";
import BackgroundScroll from "../components/react/BackgroundScroll";
import HeroSlider from "../components/react/HeroSlider";
import OfficialUpdatePanel from "../components/react/OfficialUpdatePanel";
import DualPanels from "../components/react/DualPanels";
import ServicesSection from "../components/react/ServicesSection";
import ProjectsShowcase from "../components/react/ProjectsShowcase";
import CertificatesModal from "../components/react/CertificatesModal";
import ContactInteractive from "../components/react/ContactInteractive";
import ScrollToTop from "../components/react/ScrollToTop";
---

<Layout
  title="Paulo Espinoza | Ingeniero de Sistemas de Información · Sitio Oficial"
  description="Sitio oficial de Paulo Espinoza — Ingeniero de Sistemas de Información de la UPC. Especializado en arquitectura backend en Java (Spring Boot), .NET, bases de datos relacionales y desarrollo asistido por IA."
>
  <!-- Top Progress Bar -->
  <ScrollProgress client:load />

  <!-- Flat Technical Grid Background -->
  <BackgroundScroll client:load />

  <!-- Flat Navbar -->
  <Navbar />

  <!-- Main Content Flow (Flat Design) -->
  <main class="relative z-10 space-y-8">
    <!-- Hero Slider with Flat Controls -->
    <HeroSlider client:load />

    <!-- Official Live Facts Collapsible Bar -->
    <OfficialUpdatePanel client:load />

    <!-- Dual Facets Panels (Professional & Academic) -->
    <DualPanels client:load />

    <!-- Featured Services Overview -->
    <ServicesSection client:load />

    <!-- Featured Portfolio Cases -->
    <ProjectsShowcase client:load />

    <!-- Verified Credentials & Certificates -->
    <CertificatesModal client:load />

    <!-- Official Recruiter Contact Section -->
    <ContactInteractive client:load />
  </main>

  <!-- Official Flat Footer -->
  <Footer />

  <!-- Floating Back to Top Button -->
  <ScrollToTop client:load />
</Layout>
