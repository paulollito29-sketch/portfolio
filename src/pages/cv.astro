---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/icons/Icon.astro";
import { getCollection } from "astro:content";

const certificates = (await getCollection("certificates")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout
  title="Curriculum Vitae Ejecutivo | Paulo Espinoza · Ingeniero de Sistemas de Información (UPC)"
  description="Currículum Vitae oficial (ES | EN) de Paulo Daniel Espinoza Gamboa — Estudiante de 7º ciclo de Ingeniería de Sistemas de Información (UPC). Experiencia en Servicio de Informática de la Fuerza Aérea, Java (Spring Boot), React.js y SQL."
>
  <div class="print:hidden">
    <Navbar />
  </div>

  <main class="max-w-5xl mx-auto px-4 sm:px-8 pt-24 pb-16 print:pt-4 print:pb-4 print:px-0">
    <!-- Top Action Bar (hidden on print) -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8 pb-6 print:hidden">
      <div>
        <span class="text-xs font-semibold text-zinc-400 block mb-1">
          Documento oficial · Actualizado 2026
        </span>
        <h1 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight">
          Curriculum Vitae Ejecutivo
        </h1>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <!-- Language Switcher Toggle -->
        <div class="inline-flex rounded bg-[#181818] p-1 text-xs">
          <button
            id="btnLangEs"
            type="button"
            class="px-3 py-1.5 rounded font-semibold transition-colors bg-[#b11226] text-white cursor-pointer"
            onclick="setCVLanguage('es')"
          >
            Español (ES)
          </button>
          <button
            id="btnLangEn"
            type="button"
            class="px-3 py-1.5 rounded font-medium transition-colors text-zinc-400 hover:text-white cursor-pointer"
            onclick="setCVLanguage('en')"
          >
            English (EN)
          </button>
        </div>

        <button
          onclick="window.print()"
          class="btn-primary text-xs cursor-pointer inline-flex items-center gap-2"
        >
          <Icon name="download" class="w-4 h-4" />
          <span>Imprimir / PDF</span>
        </button>

        <a
          href="/contact"
          class="btn-secondary text-xs"
        >
          Contactar
        </a>
      </div>
    </div>

    <!-- CV Paper Container -->
    <div class="bg-[#151515] print:bg-white rounded-lg p-6 sm:p-10 print:p-0 space-y-7 print:space-y-5 text-zinc-300 print:text-zinc-900">
      
