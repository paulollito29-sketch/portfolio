  <script is:inline>
    function setCVLanguage(lang) {
      var esContent = document.getElementById("cvContentEs");
      var enContent = document.getElementById("cvContentEn");
      var btnEs = document.getElementById("btnLangEs");
      var btnEn = document.getElementById("btnLangEn");

      if (lang === "en") {
        if (esContent) esContent.classList.add("hidden");
        if (enContent) enContent.classList.remove("hidden");
        if (btnEn) {
          btnEn.className = "px-3 py-1.5 rounded font-semibold transition-colors bg-[#b11226] text-white cursor-pointer";
        }
        if (btnEs) {
          btnEs.className = "px-3 py-1.5 rounded font-medium transition-colors text-zinc-400 hover:text-white cursor-pointer";
        }
      } else {
        if (enContent) enContent.classList.add("hidden");
        if (esContent) esContent.classList.remove("hidden");
        if (btnEs) {
          btnEs.className = "px-3 py-1.5 rounded font-semibold transition-colors bg-[#b11226] text-white cursor-pointer";
        }
        if (btnEn) {
          btnEn.className = "px-3 py-1.5 rounded font-medium transition-colors text-zinc-400 hover:text-white cursor-pointer";
        }
      }
    }
  </script>
</Layout>
