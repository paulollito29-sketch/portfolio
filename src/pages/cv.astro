          <!-- Idiomas -->
          <section class="space-y-2">
            <h3 class="text-sm font-bold text-white print:text-zinc-950 pb-1">
              Idiomas
            </h3>
            <ul class="text-xs text-zinc-300 print:text-zinc-800 space-y-1">
