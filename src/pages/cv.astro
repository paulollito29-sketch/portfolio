---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/icons/Icon.astro";
import { getCollection, getEntry } from "astro:content";

const personalEntry = await getEntry("profile", "personal");
const p = personalEntry?.data.personal;

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const skills = await getCollection("skills");
const certificates = (await getCollection("certificates")).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Curriculum Vitae Ejecutivo | Paulo Espinoza · Ingeniero de Sistemas de Información"
  description="Currículum Vitae oficial de Paulo Espinoza — Ingeniero de Sistemas de Información de la UPC. Especialista en arquitectura backend en Java (Spring Boot), .NET, bases de datos y desarrollo web."
>
  <div class="print:hidden">
    <Navbar />
  </div>

  <main class="max-w-5xl mx-auto px-4 sm:px-8 pt-24 pb-16 print:pt-6 print:pb-6 print:px-0">
    <!-- Top Action Bar (hidden on print) -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-[#1d2230] print:hidden">
      <div>
        <span class="text-xs font-semibold text-sky-400 block mb-1">
          Resumen Ejecutivo
        </span>
        <h1 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight">
          Curriculum Vitae Profesional
        </h1>
      </div>

      <div class="flex items-center gap-3">
        <button
          onclick="window.print()"
          class="flat-btn-primary active:scale-95 text-xs cursor-pointer"
        >
          <Icon name="download" class="w-4 h-4" />
          <span>Imprimir / Guardar en PDF</span>
        </button>

        <a
          href="/contact"
          class="flat-btn-outline active:scale-95 text-xs"
        >
          Contactar
        </a>
      </div>
    </div>

    <!-- CV Paper Container -->
    <div class="bg-[#10121a] print:bg-white border border-[#1d2230] print:border-none rounded-lg p-6 sm:p-10 print:p-0 space-y-8 print:space-y-6 text-zinc-300 print:text-zinc-900">
      <!-- Header -->
      <header class="border-b border-[#181d29] print:border-zinc-300 pb-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="text-2xl sm:text-3xl font-display font-bold text-white print:text-black">
              {p?.fullName || "Paulo Daniel Espinoza Gamboa"}
            </h2>
            <p class="text-base text-sky-400 print:text-sky-700 font-semibold mt-1">
              {p?.title.es || "Ingeniero de Sistemas de Información"}
            </p>
            <p class="text-xs text-zinc-400 print:text-zinc-600 mt-0.5">
              {p?.university || "Universidad Peruana de Ciencias Aplicadas (UPC)"} · {p?.location.es || "Lima, Perú"}
            </p>
          </div>

          <div class="space-y-1 text-xs text-zinc-400 print:text-zinc-700 text-left sm:text-right">
            <div>
              <a href={`mailto:${p?.email}`} class="hover:text-sky-400 underline">{p?.email}</a>
            </div>
            <div>
              <span>{p?.phone}</span>
            </div>
            <div>
              <a href={p?.linkedinUrl} target="_blank" rel="noopener noreferrer" class="hover:text-sky-400 underline">LinkedIn</a>
              <span class="mx-1">·</span>
              <a href={p?.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-sky-400 underline">GitHub</a>
            </div>
          </div>
        </div>
      </header>

      <!-- Profile Summary -->
      <section class="space-y-2">
        <h3 class="text-xs font-semibold text-sky-400 print:text-sky-800 border-b border-[#181d29] print:border-zinc-300 pb-1">
          Perfil Profesional
        </h3>
        <p class="text-xs sm:text-sm leading-relaxed text-zinc-300 print:text-zinc-800">
          {p?.bioParagraphs.es[0]}
        </p>
        <p class="text-xs sm:text-sm leading-relaxed text-zinc-300 print:text-zinc-800">
          {p?.bioParagraphs.es[1]}
        </p>
      </section>

      <!-- Technical Skills Matrix -->
      <section class="space-y-3">
        <h3 class="text-xs font-semibold text-sky-400 print:text-sky-800 border-b border-[#181d29] print:border-zinc-300 pb-1">
          Competencias Técnicas &amp; Stack
        </h3>
        <div class="grid sm:grid-cols-2 gap-3">
          {skills.map((skill) => (
            <div class="p-3.5 rounded-lg bg-[#0a0b10] print:bg-zinc-50 border border-[#181d29] print:border-zinc-200">
              <h4 class="text-xs font-bold text-white print:text-zinc-900 mb-1.5">
                {skill.data.label.es}
              </h4>
              <div class="flex flex-wrap gap-1.5">
                {skill.data.competencies.map((comp) => (
                  <span class="text-[11px] px-2 py-0.5 rounded bg-[#161922] print:bg-zinc-200 text-zinc-300 print:text-zinc-800">
                    {comp.name}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Projects / Experience -->
      <section class="space-y-3">
        <h3 class="text-xs font-semibold text-sky-400 print:text-sky-800 border-b border-[#181d29] print:border-zinc-300 pb-1">
          Casos de Estudio &amp; Proyectos Destacados
        </h3>
        <div class="space-y-4">
          {projects.map((proj) => (
            <div class="border-l-2 border-sky-400 pl-3.5 space-y-1">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between">
                <h4 class="text-xs sm:text-sm font-bold text-white print:text-zinc-900">
                  {proj.data.title}
                </h4>
                <span class="text-xs text-zinc-400 print:text-zinc-600">
                  {proj.data.kicker?.es ?? proj.data.categoryName.es} · {proj.data.year}
                </span>
              </div>
              <p class="text-xs text-zinc-300 print:text-zinc-700 leading-relaxed">
                {proj.data.summary?.es ?? proj.data.description.es}
              </p>
              <div class="flex flex-wrap gap-1.5 pt-1">
                {proj.data.tags.map((t) => (
                  <span class="text-[11px] px-2 py-0.5 rounded bg-[#0a0b10] print:bg-zinc-100 text-zinc-400 print:text-zinc-600 border border-[#181d29] print:border-zinc-300">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Education & Certifications -->
      <section class="space-y-3">
        <h3 class="text-xs font-semibold text-sky-400 print:text-sky-800 border-b border-[#181d29] print:border-zinc-300 pb-1">
          Formación &amp; Certificaciones Oficiales
        </h3>

        <div class="mb-3">
          <div class="flex justify-between items-baseline">
            <h4 class="text-xs sm:text-sm font-bold text-white print:text-zinc-900">
              Universidad Peruana de Ciencias Aplicadas (UPC)
            </h4>
            <span class="text-xs text-zinc-400 print:text-zinc-600">Lima, Perú</span>
          </div>
          <p class="text-xs text-zinc-300 print:text-zinc-700">
            Ingeniería de Sistemas de Información
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-2.5 pt-2">
          {certificates.map((cert) => (
            <div class="flex items-start gap-2 text-xs">
              <span class="text-sky-400 print:text-sky-700 shrink-0">•</span>
              <div>
                <span class="font-medium text-white print:text-zinc-900">{cert.data.title.es}</span>
                <span class="block text-[11px] text-zinc-400 print:text-zinc-600">
                  {cert.data.issuer} ({cert.data.institution})
                </span>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <div class="print:hidden">
    <Footer />
  </div>
</Layout>
