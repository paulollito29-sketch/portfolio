  <script is:inline>
    function setCVLanguage(lang) {
      var esContent = document.getElementById("cvContentEs");
      var enContent = document.getElementById("cvContentEn");
      var btnEs = document.getElementById("btnLangEs");
      var btnEn = document.getElementById("btnLangEn");

      if (lang === "en") {
        if (esContent) esContent.classList.add("hidden");
        if (enContent) enContent.classList.remove("hidden");
        if (btnEn) {
          btnEn.className = "px-3 py-1.5 rounded font-semibold transition-[background-color,color] duration-150 bg-sky-500 text-zinc-950 cursor-pointer";
        }
        if (btnEs) {
          btnEs.className = "px-3 py-1.5 rounded font-medium transition-[background-color,color] duration-150 text-zinc-400 hover:text-white cursor-pointer";
        }
      } else {
        if (enContent) enContent.classList.add("hidden");
        if (esContent) esContent.classList.remove("hidden");
        if (btnEs) {
          btnEs.className = "px-3 py-1.5 rounded font-semibold transition-[background-color,color] duration-150 bg-sky-500 text-zinc-950 cursor-pointer";
        }
        if (btnEn) {
          btnEn.className = "px-3 py-1.5 rounded font-medium transition-[background-color,color] duration-150 text-zinc-400 hover:text-white cursor-pointer";
        }
      }
    }
  </script>
</Layout>
