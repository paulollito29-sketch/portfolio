---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import ScrollProgress from "../components/react/ScrollProgress";
import BackgroundScroll from "../components/react/BackgroundScroll";
import CertificatesModal from "../components/react/CertificatesModal";
import ScrollToTop from "../components/react/ScrollToTop";
---

<Layout
  title="Certificaciones Oficiales | Paulo Espinoza · Meta, Oracle & Michigan"
  description="Certificaciones auditadas y acreditaciones oficiales obtenidas por Paulo Espinoza de Meta, Oracle Academy y University of Michigan en desarrollo web, SQL y Python."
>
  <ScrollProgress client:load />
  <BackgroundScroll client:load />
  <Navbar />

  <main class="relative z-10 pt-24 pb-16 space-y-12">
    <!-- Page Header Banner -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-xs font-mono text-cyan-400 uppercase tracking-widest mb-4">
        <span>ACREDITACIONES INTERNACIONALES AUDITADAS</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-display font-bold text-white uppercase tracking-tight">
        Certificaciones &amp; Grados
      </h1>
      <p class="text-base sm:text-xl text-slate-300 font-light max-w-3xl mt-3 leading-relaxed">
        Validación oficial de competencias profesionales emitida por líderes globales de la industria tecnológica y universidades de prestigio mundial.
      </p>
    </div>

    <!-- Certificates Modal Component with PDF Viewer -->
    <CertificatesModal client:load />
  </main>

  <Footer />
  <ScrollToTop client:load />
</Layout>
