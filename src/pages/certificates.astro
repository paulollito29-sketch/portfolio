---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import BackgroundScroll from "../components/BackgroundScroll.astro";
import CertificatesModal from "../components/CertificatesModal.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
---

<Layout
  title="Certificaciones Oficiales | Paulo Espinoza · Meta, Oracle & Michigan"
  description="Certificaciones auditadas y acreditaciones oficiales obtenidas por Paulo Espinoza de Meta, Oracle Academy y University of Michigan en desarrollo web, SQL y Python."
>
  <ScrollProgress />
  <BackgroundScroll />
  <Navbar />

  <main class="relative z-10 pt-20 pb-16 space-y-10">
    <!-- Page Header Banner -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-8 space-y-3">
      <h1 class="text-3xl sm:text-5xl font-display font-bold text-[var(--ink)] tracking-tight">
        Certificaciones Oficiales &amp; Acreditaciones
      </h1>
      <p class="text-sm sm:text-base text-[var(--ink-secondary)] max-w-3xl leading-relaxed">
        Validación técnica verificable emitida por instituciones globales (Meta, Oracle Academy y University of Michigan).
      </p>
    </div>

    <!-- Certificates Modal Component with PDF Viewer -->
    <CertificatesModal />
  </main>

  <Footer />
  <ScrollToTop />
</Layout>
