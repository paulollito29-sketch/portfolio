---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import ScrollProgress from "../components/react/ScrollProgress";
import BackgroundScroll from "../components/react/BackgroundScroll";
import CertificatesModal from "../components/react/CertificatesModal";
import ScrollToTop from "../components/react/ScrollToTop";
---

<Layout
  title="Certificaciones Oficiales | Paulo Espinoza · Meta, Oracle & Michigan"
  description="Certificaciones auditadas y acreditaciones oficiales obtenidas por Paulo Espinoza de Meta, Oracle Academy y University of Michigan en desarrollo web, SQL y Python."
>
  <ScrollProgress client:load />
  <BackgroundScroll client:load />
  <Navbar />

  <main class="relative z-10 pt-20 pb-16 space-y-8">
    <!-- Page Header Banner -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-6">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-xs font-mono text-cyan-400 uppercase tracking-widest mb-3">
        <span>ACREDITACIONES INTERNACIONALES AUDITADAS</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-display font-bold text-white uppercase tracking-tight">
        Certificaciones &amp; Grados
      </h1>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-3xl mt-2 leading-relaxed">
        Validación de competencias emitida por líderes de la industria tecnológica y universidades (Meta, Oracle Academy, Univ. of Michigan).
      </p>
    </div>

    <!-- Certificates Modal Component with PDF Viewer -->
    <CertificatesModal client:load />
  </main>

  <Footer />
  <ScrollToTop client:load />
</Layout>
