---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import ScrollProgress from "../components/react/ScrollProgress";
import BackgroundScroll from "../components/react/BackgroundScroll";
import ProjectsShowcase from "../components/react/ProjectsShowcase";
import ScrollToTop from "../components/react/ScrollToTop";
---

<Layout
  title="Portafolio & Casos de Estudio | Paulo Espinoza · Ingeniero de Sistemas"
  description="Casos de estudio y sistemas empresariales desarrollados por Paulo Espinoza: microservicios en Spring Boot, aplicaciones comerciales en SQL Server, sistemas offline PWA y algoritmos."
>
  <ScrollProgress client:load />
  <BackgroundScroll client:load />
  <Navbar />

  <main class="relative z-10 pt-20 pb-16 space-y-8">
    <!-- Page Header Banner -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-6">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-xs font-mono text-cyan-400 uppercase tracking-widest mb-3">
        <span>SISTEMAS DESARROLLADOS &amp; CASOS DE ESTUDIO</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-display font-bold text-white uppercase tracking-tight">
        Portafolio de Sistemas
      </h1>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-3xl mt-2 leading-relaxed">
        Colección de sistemas empresariales, microservicios backend, arquitecturas de persistencia relacional y proyectos listos para producción.
      </p>
    </div>

    <!-- Projects Showcase Component with lead case and filters -->
    <ProjectsShowcase client:load />

    <!-- GitHub CTA Card (Flat) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-6">
      <div class="p-6 rounded-lg bg-[#121215] border border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-lg font-bold text-white uppercase mb-1">
            ¿Deseas explorar más código fuente?
          </h3>
          <p class="text-xs text-zinc-400">
            Visita mi repositorio en GitHub para revisar los commits, controladores y pruebas técnicas.
          </p>
        </div>
        <a
          href="https://github.com/paulollito29-sketch"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded bg-white hover:bg-cyan-400 text-black font-semibold text-xs uppercase tracking-wider transition-colors shrink-0"
        >
          Ver Perfil en GitHub →
        </a>
      </div>
    </div>
  </main>

  <Footer />
  <ScrollToTop client:load />
</Layout>
