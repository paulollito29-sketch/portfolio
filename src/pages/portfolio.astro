---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import BackgroundScroll from "../components/BackgroundScroll.astro";
import ProjectsShowcase from "../components/ProjectsShowcase.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
---

<Layout
  title="Portafolio & Casos de Estudio | Paulo Espinoza · Ingeniero de Sistemas"
  description="Casos de estudio y sistemas empresariales desarrollados por Paulo Espinoza: microservicios en Spring Boot, aplicaciones comerciales en SQL Server, sistemas offline PWA y algoritmos."
>
  <ScrollProgress />
  <BackgroundScroll />
  <Navbar />

  <main class="relative z-10 pt-20 pb-16 space-y-10">
    <!-- Page Header Banner -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-8 space-y-3">
      <h1 class="text-3xl sm:text-5xl font-display font-bold text-white tracking-tight">
        Portafolio de Sistemas &amp; Arquitecturas
      </h1>
      <p class="text-sm sm:text-base text-zinc-300 max-w-3xl leading-relaxed">
        Sistemas empresariales en producción, microservicios backend, persistencia relacional estructurada y código fuente auditado.
      </p>
    </div>

    <!-- Projects Showcase Component -->
    <ProjectsShowcase hideHeader />

    <!-- GitHub CTA Card -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-4">
      <div class="p-6 sm:p-7 rounded-lg bg-[#10121a] border border-[#1d2230] flex flex-col sm:flex-row items-center justify-between gap-5">
        <div>
          <h2 class="text-lg font-bold text-white mb-1">
            ¿Deseas explorar más código fuente?
          </h2>
          <p class="text-xs text-zinc-400">
            Visita mi repositorio en GitHub para revisar los commits, controladores, pruebas y esquemas de base de datos.
          </p>
        </div>
        <a
          href="https://github.com/paulollito29-sketch"
          target="_blank"
          rel="noopener noreferrer"
          class="flat-btn-primary active:scale-95 shrink-0 text-xs"
        >
          Ver Perfil en GitHub →
        </a>
      </div>
    </div>
  </main>

  <Footer />
  <ScrollToTop />
</Layout>
