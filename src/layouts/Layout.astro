---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Paulo Espinoza | Ingeniero de Sistemas de Información · Sitio Oficial",
  description = "Sitio oficial de Paulo Espinoza — Ingeniero de Sistemas de Información de la UPC. Especialista en arquitectura backend en Java (Spring Boot), .NET, metodología SDD, bases de datos relacionales y desarrollo web.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Paulo Espinoza" />
    <meta name="theme-color" content="#0a0b10" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_PE" />

    <!-- Google Fonts for Typography: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0a0b10] text-zinc-100 min-h-[100svh] antialiased selection:bg-sky-400 selection:text-zinc-950 font-sans">
    <slot />
  </body>
</html>
