---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Paulo Espinoza · Ingeniero de Sistemas de Información (UPC)",
  description = "Portafolio oficial de Paulo Daniel Espinoza Gamboa — Estudiante de 7º ciclo de Ingeniería de Sistemas de Información (UPC) con 8 meses de experiencia en el Servicio de Informática de la Fuerza Aérea. Especializado en Java, Spring Boot, bases de datos relacionales y arquitectura SDD.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Paulo Espinoza" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_PE" />

    <!-- Local Clash Grotesk Typography Preload -->
    <link rel="preload" href="/fonts/clash-grotesk-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/clash-grotesk-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/clash-grotesk-600.woff2" as="font" type="font/woff2" crossorigin />

    <!-- LCP Hero Image Preload -->
    <link rel="preload" as="image" href="/assets/technician-with-laptop-working-on-server-rack.webp" type="image/webp" fetchpriority="high" />
  </head>
  <body class="bg-[#0a0a0a] text-[#efefef] min-h-[100svh] antialiased selection:bg-[#b11226] selection:text-white font-sans overflow-x-clip">
    <slot />
  </body>
</html>
