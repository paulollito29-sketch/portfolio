---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Paulo Espinoza | Desarrollador Full Stack & Software Engineer",
  description = "Portafolio profesional de Paulo Espinoza. Estudiante de Ingeniería de Sistemas en UPC, especializado en Java (Spring Boot), C# (.NET), React, interfaces modernas y desarrollo asistido por IA.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Paulo Espinoza" />
    <meta name="theme-color" content="#07090e" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_PE" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#07090e] text-zinc-100 min-h-screen antialiased selection:bg-blue-600 selection:text-white">
    <slot />
  </body>
</html>
